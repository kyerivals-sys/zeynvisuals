-- FEATURE 8: MORPH (Copy Roblox User Avatar & Accessories)
----------------------------------------------------------------
local function ExecMorph(targetUsername)
    if not targetUsername or targetUsername == "" then
        AddLog("Usage: morph <robloxusername>", "ERROR")
        return
    end

    AddLog(string.format("Morphing avatar into '%s'...", targetUsername), "INFO")

    task.spawn(function()
        local userRes = ResolveUser(targetUsername)
        if not userRes then
            AddLog(string.format("Could not resolve user '%s'", targetUsername), "ERROR")
            return
        end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChildOfClass("Humanoid") then
            AddLog("Local character or Humanoid not found!", "ERROR")
            return
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not hrp then
            AddLog("HumanoidRootPart not found!", "ERROR")
            return
        end

        -- Method 1: Native ApplyDescription
        pcall(function()
            local humDesc = Players:GetHumanoidDescriptionFromUserId(userRes.UserId)
            if humDesc then
                hum:ApplyDescription(humDesc)
            end
        end)

        -- Method 2: Full 3D Asset & Accessory Transfer
        local okModel, targetModel = pcall(function()
            return Players:CreateHumanoidModelFromUserId(userRes.UserId)
        end)

        if okModel and targetModel then
            pcall(function()
                local targetHrp = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
                if not targetHrp then targetHrp = targetModel:FindFirstChild("Torso") or targetModel:FindFirstChild("UpperTorso") end

                local charPivot = char:GetPivot()
                targetModel:PivotTo(charPivot)

                -- Clear existing local character accessories & classic clothing
                for _, item in ipairs(char:GetChildren()) do
                    if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
                        item:Destroy()
                    end
                end

                -- Transfer BodyColors, Shirts, Pants, ShirtGraphic, CharacterMeshes
                for _, item in ipairs(targetModel:GetChildren()) do
                    if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
                        item:Clone().Parent = char
                    end
                end

                -- Transfer Head face decal and head mesh (SpecialMesh)
                local head = char:FindFirstChild("Head")
                local targetHead = targetModel:FindFirstChild("Head")

                if head then
                    for _, child in ipairs(head:GetChildren()) do
                        if child:IsA("Decal") or child:IsA("SpecialMesh") then
                            child:Destroy()
                        end
                    end
                end

                if head and targetHead then
                    for _, child in ipairs(targetHead:GetChildren()) do
                        if child:IsA("Decal") or child:IsA("SpecialMesh") then
                            child:Clone().Parent = head
                        end
                    end
                end

                -- Transfer MeshPart visuals for body parts
                for _, targetPart in ipairs(targetModel:GetChildren()) do
                    if targetPart:IsA("MeshPart") and char:FindFirstChild(targetPart.Name) then
                        local charPart = char[targetPart.Name]
                        pcall(function()
                            if charPart:IsA("MeshPart") then
                                charPart.MeshId = targetPart.MeshId
                                charPart.TextureID = targetPart.TextureID
                                charPart.Color = targetPart.Color
                                charPart.Transparency = targetPart.Transparency
                            end
                        end)
                    end
                end

                -- Transfer ALL 3D Accessories
                for _, item in ipairs(targetModel:GetChildren()) do
                    if item:IsA("Accessory") then
                        local accClone = item:Clone()

                        for _, desc in ipairs(accClone:GetDescendants()) do
                            if desc:IsA("Weld") or desc:IsA("WeldConstraint") or desc:IsA("Motor6D") then
                                desc:Destroy()
                            end
                        end

                        local handle = accClone:FindFirstChild("Handle")
                        if handle and handle:IsA("BasePart") then
                            handle.CanCollide = false
                            handle.Anchored = false

                            local handleAtt = handle:FindFirstChildWhichIsA("Attachment")
                            local charAtt = nil

                            if handleAtt then
                                charAtt = char:FindFirstChild(handleAtt.Name, true)
                            end

                            if charAtt and charAtt.Parent and charAtt.Parent:IsA("BasePart") then
                                local bodyPart = charAtt.Parent
                                handle.CFrame = charAtt.WorldCFrame * handleAtt.CFrame:Inverse()

                                local weld = Instance.new("Weld")
                                weld.Name = "AccessoryWeld"
                                weld.Part0 = bodyPart
                                weld.Part1 = handle
                                weld.C0 = charAtt.CFrame
                                weld.C1 = handleAtt.CFrame
                                weld.Parent = handle
                            else
                                local origHandle = item:FindFirstChild("Handle")
                                if origHandle and targetHrp then
                                    local relCFrame = targetHrp.CFrame:ToObjectSpace(origHandle.CFrame)
                                    handle.CFrame = hrp.CFrame * relCFrame

                                    local weld = Instance.new("WeldConstraint")
                                    weld.Part0 = hrp
                                    weld.Part1 = handle
                                    weld.Parent = handle
                                end
                            end

                            accClone.Parent = char
                        end
                    end
                end

                -- Synchronize Humanoid Body Scale values
                local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
                if targetHum then
                    for _, prop in ipairs({"HeadScale", "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "BodyTypeScale", "Proportion"}) do
                        local targetVal = targetHum:FindFirstChild(prop)
                        if targetVal and targetVal:IsA("NumberValue") then
                            local myVal = hum:FindFirstChild(prop)
                            if myVal and myVal:IsA("NumberValue") then
                                myVal.Value = targetVal.Value
                            end
                        end
                    end
                end
            end)

            targetModel:Destroy()
        end

        AddLog(string.format("Successfully morphed avatar into '%s'!", userRes.Name), "SUCCESS")
    end)
end


local function NormalizeMultiplier(str)
    if not str or str == "" then return nil end
    str = str:lower():gsub("%s+", "")
    -- Format: x2, x4, x1.25, x10
    local n1 = str:match("^x([%d%.]+)$")
    if n1 and tonumber(n1) then
        return "x" .. n1
    end
    -- Format: 2x, 4x, 1.25x, 10x
    local n2 = str:match("^([%d%.]+)x$")
    if n2 and tonumber(n2) then
        return "x" .. n2
    end
    return nil
end

local function IsDurationToken(str)
    if not str or str == "" then return false end
    str = str:lower():gsub("%s+", "")
    if str:match("^%d+h$") or str:match("^%d+m$") or str:match("^%d+s$")
       or str:match("^%d+h%d+m$") or str:match("^%d+m%d+s$") then
        return true
    end
    return false
end

local function ParseBoostDuration(str)
    if not str or str == "" then return 1800 end
    str = str:lower():gsub("%s+", "")
    local totalSecs = 0
    local matched = false

    local hours = str:match("(%d+)h")
    if hours then
        totalSecs = totalSecs + tonumber(hours) * 3600
        matched = true
    end
    local mins = str:match("(%d+)m")
    if mins then
        totalSecs = totalSecs + tonumber(mins) * 60
        matched = true
    end
    local secs = str:match("(%d+)s")
    if secs then
        totalSecs = totalSecs + tonumber(secs)
        matched = true
    end

    if not matched then
        local num = tonumber(str)
        if num then
            if num <= 120 then
                totalSecs = num * 60 -- e.g. "30" = 30 minutes
            else
                totalSecs = num -- e.g. "300" = 300 seconds
            end
            matched = true
        end
    end

    if matched and totalSecs > 0 then
        return totalSecs
    end
    return 1800
end

local function FormatBoostTime(seconds)
    if seconds <= 0 then return "0s" end
    local success, formatted = pcall(function()
        local timeMod = require(game:GetService("ReplicatedStorage").Shared.Utils.Time)
        if timeMod and timeMod.Elapsed then
            return timeMod.Elapsed(seconds)
        end
    end)
    if success and formatted and formatted ~= "" then
        return formatted
    end

    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    if h > 0 then
        if m > 0 then
            return string.format("%dh %dm", h, m)
        else
            return string.format("%dh %ds", h, s)
        end
    elseif m > 0 then
        if s > 0 then
            return string.format("%dm %ds", m, s)
        else
            return string.format("%dm", m)
        end
    else
        return string.format("%ds", s)
    end
end


                    task.delay(0.55, function()
                        if shockInner and shockInner.Parent then shockInner:Destroy() end
                        if shockOuter and shockOuter.Parent then shockOuter:Destroy() end
                    end)
                end)

                -- Superhero Landing Crouch Compression & Elastic Rebound
                if botModel and botModel.Parent then
                    botModel:PivotTo(safeCFrame * CFrame.new(0, -0.65, 0))
                    task.wait(0.06)
                    if botModel and botModel.Parent then
                        botModel:PivotTo(safeCFrame * CFrame.new(0, 0.15, 0))

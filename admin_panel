local function ResolveUser(username)
    username = tostring(username or ""):lower():gsub("%s+", "")
    if username == "" then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(username, 1, true) or p.DisplayName:lower():find(username, 1, true) then
            local isVerified = false
            pcall(function()
                local info = UserService:GetUserInfosByUserIdsAsync({p.UserId})[1]
                if info and info.HasVerifiedBadge then isVerified = true end
            end)
            return {
                Name = p.Name,
                DisplayName = p.DisplayName,
                UserId = p.UserId,
                IsVerified = isVerified,
                Player = p
            }
        end
    end

    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and userId then
        local isVerified = false
        local actualName = username
        local displayName = username
        pcall(function()
            local info = UserService:GetUserInfosByUserIdsAsync({userId})[1]
            if info then
                actualName = info.Username or username
                displayName = info.DisplayName or actualName
                if info.HasVerifiedBadge then isVerified = true end
            end
        end)
        return {
            Name = actualName,
            DisplayName = displayName,
            UserId = userId,
            IsVerified = isVerified,
            Player = nil
        }
    end

    return nil
end

local function GetSafezoneCFrame()
    local spawnLoc = workspace:FindFirstChild("SpawnLocation")
    if spawnLoc and spawnLoc:IsA("BasePart") then
        return spawnLoc.CFrame + Vector3.new(0, 4, 0)
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        local safe = map:FindFirstChild("SafeZone") or map:FindFirstChild("Safezone") or map:FindFirstChild("Spawn")
        if safe then
            return safe:IsA("BasePart") and safe.CFrame or safe:GetPivot()
        end
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return LocalPlayer.Character.HumanoidRootPart.CFrame
    end
    return CFrame.new(0, 50, 0)
end


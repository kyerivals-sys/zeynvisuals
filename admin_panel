                if not isJumping and now >= nextRandomJumpTime then
                    TriggerJump()
                    nextRandomJumpTime = now + math.random(25, 50) * 0.1
                end

                local jumpY = 0
                if isJumping then
                    local elapsed = now - jumpStartTime
                    if elapsed < jumpDuration then
                        local progress = elapsed / jumpDuration
                        jumpY = math.sin(progress * math.pi) * jumpHeight
                    else
                        isJumping = false
                        jumpY = 0
                    end
                end

                local bPos = botModel:GetPivot().Position

                -- Check if player is also inside the safezone (X <= 548)
                local playerInSafezone = pPos and (pPos.X <= 548.0 and pPos.X >= 460.0 and pPos.Z >= -420.0 and pPos.Z <= -300.0)

                if playerInSafezone and cHrp then
                    -- Follow player strictly within safezone boundaries
                    local flatToPlayer = Vector3.new(pPos.X - bPos.X, 0, pPos.Z - bPos.Z)
                    local dist = flatToPlayer.Magnitude
                    if dist > 6.0 then
                        isRunning = true
                        local moveDir = flatToPlayer.Unit
                        local stepDist = math.min(dist - 5.0, 24.0 * dt)
                        local targetX = math.clamp(bPos.X + moveDir.X * stepDist, 472.0, 546.0)
                        local targetZ = math.clamp(bPos.Z + moveDir.Z * stepDist, -410.0, -315.0)
                        local gY = GetFollowerGroundHeight(Vector3.new(targetX, 68, targetZ), 3.0)
                        local lookAhead = Vector3.new(targetX + moveDir.X * 5, gY + jumpY, targetZ + moveDir.Z * 5)
                        botModel:PivotTo(CFrame.lookAt(Vector3.new(targetX, gY + jumpY, targetZ), lookAhead))
                    else
                        isRunning = false
                        local gY = GetFollowerGroundHeight(bPos, 3.0)
                        local facePt = Vector3.new(pPos.X, gY, pPos.Z)
                        botModel:PivotTo(CFrame.lookAt(Vector3.new(bPos.X, gY + jumpY, bPos.Z), facePt))
                    end
                else
                    -- Player is outside in arena: Bot CANNOT pass through the white block or walls, stays in safezone running waiting for morning!
                    if not isWandering or not currentWaypoint then
                        local rx = math.random(478, 538)
                        local rz = math.random(-395, -335)
                        currentWaypoint = Vector3.new(rx, 68, rz)
                        isWandering = true
                        nextWanderTime = now + 4.0
                    end

                    local flatWander = Vector3.new(currentWaypoint.X - bPos.X, 0, currentWaypoint.Z - bPos.Z)
                    if flatWander.Magnitude > 2.0 and now < nextWanderTime then
                        isRunning = true
                        local moveDir = flatWander.Unit
                        local stepDist = math.min(flatWander.Magnitude, 20.0 * dt)
                        -- Strictly clamp to safezone: NEVER cross X = 546.0 into the arena/wall!
                        local targetX = math.clamp(bPos.X + moveDir.X * stepDist, 472.0, 546.0)
                        local targetZ = math.clamp(bPos.Z + moveDir.Z * stepDist, -410.0, -315.0)
                        local gY = GetFollowerGroundHeight(Vector3.new(targetX, 68, targetZ), 3.0)
                        local lookAhead = Vector3.new(targetX + moveDir.X * 5, gY + jumpY, targetZ + moveDir.Z * 5)
                        botModel:PivotTo(CFrame.lookAt(Vector3.new(targetX, gY + jumpY, targetZ), lookAhead))
                    else
                        isWandering = false
                        currentWaypoint = nil
                        isRunning = false
                        task.wait(math.random(3, 8) * 0.1)
                    end
                end

                task.wait(0.016)
            end

            isRunning = false
            isWandering = false
            currentWaypoint = nil
        end

        -- Responsive Player AI Following Loop (Teleport Bot Speed = 60 studs/s, Smooth movement, Frequent jumping, Big area roaming)
        while FollowerBotLoopActive and botModel and botModel.Parent do
            -- Night time / White wall check: teleport immediately to safezone and wait for morning!
            if IsNightTime() or IsWhiteWallUp() then
                RunFollowerSafezoneNightLoop()
            end
            if not (FollowerBotLoopActive and botModel and botModel.Parent) then break end

            local now = os.clock()
            local dt = now - lastClock
            lastClock = now
            if dt <= 0 or dt > 0.1 then dt = 0.016 end

            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

            if myHrp and myHum and myHum.Health > 0 then
                local botPivot = botModel:GetPivot()
                local botPos = botPivot.Position
                local playerPos = myHrp.Position

                -- Run speed: toned down to a natural companion jog speed (32 studs/s)
                local runSpeed = 32.0
                curWalkSpeed = runSpeed

                -- Detect if player is actually moving
                local playerMoving = (myHum.MoveDirection.Magnitude > 0.05)
                    or (Vector3.new(myHrp.AssemblyLinearVelocity.X, 0, myHrp.AssemblyLinearVelocity.Z).Magnitude > 1.2)

                -- Track player stopped / moving state
                if playerMoving then
                    playerStoppedTime = 0
                    isWandering = false
                    currentWaypoint = nil
                    nextWanderTime = 0
                else
                    if playerStoppedTime == 0 then
                        playerStoppedTime = now
                        nextWanderTime = now + 0.6 -- starts roaming across area quickly after you stop
                        isWandering = false
                        currentWaypoint = nil
                    end
                end

                -- Record player's breadcrumb path as they walk
                if playerMoving then
                    if not lastRecordPos or (Vector3.new(playerPos.X - lastRecordPos.X, 0, playerPos.Z - lastRecordPos.Z).Magnitude > 0.4) then
                        lastRecordPos = playerPos
                        table.insert(pathHistory, {pos = playerPos, t = now})
                        while #pathHistory > 1 and (now - pathHistory[1].t > 3.0) do
                            table.remove(pathHistory, 1)
                        end
                    end
                end

                -- Dynamic casual jumping (jumps frequently: every 2.5s - 5.5s while moving/running)
                if (isRunning or isWandering) and not isJumping and now >= nextRandomJumpTime then
                    TriggerJump()
                    nextRandomJumpTime = now + math.random(25, 55) * 0.1
                end

                -- Occasional rage weapon swings while moving / roaming ("a little bit rage")
                if (isRunning or isWandering) and not isRageSwinging and now >= nextRageSwingTime then
                    TriggerRageSlash()
                    nextRageSwingTime = now + math.random(40, 75) * 0.1
                end

                -- Imitate player jumps (responds quickly when you jump)
                if (myHum.Jump or myHum:GetState() == Enum.HumanoidStateType.Jumping) and not jumpDebounce then
                    jumpDebounce = true
                    task.delay(math.random(10, 22) * 0.01, function()
                        if FollowerBotLoopActive and botModel and botModel.Parent then
                            TriggerJump()
                        end
                        task.wait(1.2)
                        jumpDebounce = false
                    end)
                end

                -- Calculate jump height offset
                local jumpY = 0
                if isJumping then
                    local elapsed = now - jumpStartTime
                    if elapsed < jumpDuration then
                        local progress = elapsed / jumpDuration
                        jumpY = math.sin(progress * math.pi) * jumpHeight
                    else
                        isJumping = false
                        jumpY = 0
                    end
                end

                local flatBotToPlayer = Vector3.new(playerPos.X - botPos.X, 0, playerPos.Z - botPos.Z)
                local directPlayerDist = flatBotToPlayer.Magnitude

                -- 1. Player is NOT moving (Standing still or AFK): Bot roams comfortably near player
                if not playerMoving then
                    pathHistory = {} -- clear breadcrumbs

                    -- If player is too far away (> 32 studs), dash back closer
                    if directPlayerDist > 32.0 then
                        isWandering = false
                        currentWaypoint = nil
                        isStoppedAtPlayer = false
                        isRunning = true

                        local moveDir = flatBotToPlayer.Unit
                        local stepDist = math.min(directPlayerDist - 12.0, runSpeed * dt)
                        local newX = botPos.X + moveDir.X * stepDist
                        local newZ = botPos.Z + moveDir.Z * stepDist
                        local groundY = GetFollowerGroundHeight(Vector3.new(newX, botPos.Y, newZ), 3.0)

                        -- Wall & obstacle collision avoidance
                        local checkedPos = CheckObstacleCollision(botPos, Vector3.new(newX, groundY, newZ))
                        newX, newZ = checkedPos.X, checkedPos.Z

                        local lookAhead = Vector3.new(newX + moveDir.X * 6, groundY + jumpY, newZ + moveDir.Z * 6)
                        botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY + jumpY, newZ), lookAhead))
                    else
                        -- Player is nearby: ACTIVELY ROAM in a tighter, smaller companion range (radius 9 to 24 studs)
                        if (now - playerStoppedTime > 0.5) then
                            -- Check if we need to pick a new waypoint across the smaller area
                            if not isWandering then
                                if now >= nextWanderTime then
                                    wanderAngle = wanderAngle + (math.random(60, 140) * (math.random() > 0.5 and 1 or -1) * (math.pi / 180))
                                    local wanderDist = math.random(90, 240) / 10 -- 9.0 to 24.0 studs (tighter range)
                                    local candPoint = playerPos + Vector3.new(math.cos(wanderAngle) * wanderDist, 0, math.sin(wanderAngle) * wanderDist)
                                    
                                    -- Clamp wander waypoint safely away from perimeter walls
                                    local candX = math.clamp(candPoint.X, 480.0, 755.0)
                                    local candZ = math.clamp(candPoint.Z, -418.0, -310.0)
                                    candPoint = Vector3.new(candX, candPoint.Y, candZ)

                                    -- Validate playable arena floor
                                    local candGroundY = GetFollowerGroundHeight(candPoint, 3.0)
                                    if candGroundY <= 75.5 then
                                        currentWaypoint = candPoint
                                    else
                                        wanderAngle = wanderAngle + math.pi * 0.7
                                        local fallbackX = math.clamp(playerPos.X + math.cos(wanderAngle) * (wanderDist * 0.5), 480.0, 755.0)
                                        local fallbackZ = math.clamp(playerPos.Z + math.sin(wanderAngle) * (wanderDist * 0.5), -418.0, -310.0)
                                        currentWaypoint = Vector3.new(fallbackX, 68.0, fallbackZ)
                                    end
                                    isWandering = true
                                    nextWanderTime = now + 4.5 -- safety timeout
                                else
                                    -- Relaxed micro-pause before next move
                                    isRunning = false
                                    local groundY = GetFollowerGroundHeight(botPos, 3.0)
                                    local lookDir = lastAfkLookTarget or Vector3.new(playerPos.X, groundY, playerPos.Z)
                                    botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY + jumpY, botPos.Z), Vector3.new(lookDir.X, groundY + jumpY, lookDir.Z)))
                                end
                            end

                            -- Execute active jog to the waypoint
                            if isWandering and currentWaypoint then
                                local flatWander = Vector3.new(currentWaypoint.X - botPos.X, 0, currentWaypoint.Z - botPos.Z)
                                if flatWander.Magnitude > 1.8 then
                                    isRunning = true
                                    local roamSpeed = 26.0 -- Slower, relaxed companion pace
                                    curWalkSpeed = roamSpeed
                                    local moveDir = flatWander.Unit
                                    local stepDist = math.min(flatWander.Magnitude, roamSpeed * dt)
                                    local newX = botPos.X + moveDir.X * stepDist
                                    local newZ = botPos.Z + moveDir.Z * stepDist
                                    local groundY = GetFollowerGroundHeight(Vector3.new(newX, botPos.Y, newZ), 3.0)

                                    -- Obstacle collision check (cannot pass through walls or white block)
                                    local checkedPos = CheckObstacleCollision(botPos, Vector3.new(newX, groundY, newZ))
                                    newX, newZ = checkedPos.X, checkedPos.Z

                                    local lookAhead = Vector3.new(newX + moveDir.X * 6, groundY + jumpY, newZ + moveDir.Z * 6)
                                    lastAfkLookTarget = lookAhead
                                    botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY + jumpY, newZ), lookAhead))
                                else
                                    -- Reached destination: quick 0.3s - 0.8s breath
                                    isWandering = false
                                    isRunning = false
                                    currentWaypoint = nil
                                    nextWanderTime = now + math.random(3, 8) * 0.1
                                end
                            end
                        else
                            isRunning = false
                            local groundY = GetFollowerGroundHeight(botPos, 3.0)
                            if flatBotToPlayer.Magnitude > 0.5 then
                                local faceTarget = Vector3.new(playerPos.X, groundY, playerPos.Z)
                                botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY + jumpY, botPos.Z), faceTarget))
                            end
                        end
                    end
                -- 2. Player IS moving: Follow smoothly with closer companion buffer
                else
                    isWandering = false
                    currentWaypoint = nil
                    nextWanderTime = 0

                    if directPlayerDist <= 6.5 then
                        -- Natural companion buffer (does not push or crowd the player)
                        isRunning = false
                        local groundY = GetFollowerGroundHeight(botPos, 3.0)
                        if flatBotToPlayer.Magnitude > 0.5 then
                            local faceTarget = Vector3.new(playerPos.X, groundY, playerPos.Z)
                            botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY + jumpY, botPos.Z), faceTarget))
                        end
                    else
                        isRunning = true
                        curWalkSpeed = runSpeed

                        -- Follow breadcrumb path or direct player vector
                        local targetTime = now - 0.28
                        local followTarget = nil
                        for i = #pathHistory, 1, -1 do
                            if pathHistory[i].t <= targetTime then
                                followTarget = pathHistory[i].pos
                                break
                            end
                        end
                        if not followTarget then
                            followTarget = playerPos
                        end

                        local flatDelta = Vector3.new(followTarget.X - botPos.X, 0, followTarget.Z - botPos.Z)
                        if flatDelta.Magnitude < 1.0 and directPlayerDist > 6.5 then
                            followTarget = playerPos
                            flatDelta = Vector3.new(followTarget.X - botPos.X, 0, followTarget.Z - botPos.Z)
                        end

                        if flatDelta.Magnitude > 0.1 then
                            local moveDir = flatDelta.Unit
                            local stepDist = math.min(flatDelta.Magnitude, runSpeed * dt)
                            local newX = botPos.X + moveDir.X * stepDist
                            local newZ = botPos.Z + moveDir.Z * stepDist
                            local groundY = GetFollowerGroundHeight(Vector3.new(newX, botPos.Y, newZ), 3.0)

                            -- Obstacle collision check (cannot pass through walls or white block)
                            local checkedPos = CheckObstacleCollision(botPos, Vector3.new(newX, groundY, newZ))
                            newX, newZ = checkedPos.X, checkedPos.Z

                            local lookAhead = Vector3.new(newX + moveDir.X * 6, groundY + jumpY, newZ + moveDir.Z * 6)
                            botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY + jumpY, newZ), lookAhead))
                        end
                    end
                end
            else
                isRunning = false
            end
            task.wait(0.016)
        end

        isRunning = false
        isJumping = false
    end)
end


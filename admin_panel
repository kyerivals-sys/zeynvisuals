                        local cloneP = newP:Clone()
                        cloneP.CFrame = oldP.CFrame
                        cloneP.CanCollide = false
                        cloneP.Anchored = false
                        cloneP.Parent = char
                    end
                end
            end

            -- Destroy old parts
            for _, oldP in pairs(oldParts) do
                oldP:Destroy()
            end

            -- Rebuild joints and bones so animations and physics work natively with the new body shape
            hum:BuildRigFromAttachments()

            -- 3. BODY COLORS
            local bc = targetModel:FindFirstChildOfClass("BodyColors")
            if bc then
                bc:Clone().Parent = char
            end

            -- 4. 2D CATALOG CLOTHING (Shirts, Pants, T-Shirts, CharacterMeshes)

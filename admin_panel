local function IsNightTime()
    local lighting = game:GetService("Lighting")
    if lighting.ClockTime < 6.0 or lighting.ClockTime > 18.0 then
        return true
    end
    local lp = game:GetService("Players").LocalPlayer
    local pg = lp and lp:FindFirstChild("PlayerGui")
    local nt = pg and pg:FindFirstChild("HUD") and pg.HUD:FindFirstChild("GameHUD") 
        and pg.HUD.GameHUD:FindFirstChild("BottomRight") and pg.HUD.GameHUD.BottomRight:FindFirstChild("NightTimer")
    if nt then
        local img = nt:FindFirstChild("ImageLabel")
        if img and img.Image ~= "" and img.Image ~= "rbxassetid://123238464128459" then
            return true
        end
    end
    return false

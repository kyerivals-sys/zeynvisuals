        if consoleUi and consoleUi.Parent then
            consoleUi.Enabled = wasConsoleEnabled
        end

        if onComplete then
            onComplete()
        end
    end)
end

local function ToggleTeleportBot(targetUsername, spawnInFrontOfPlayer, waitAdmin)
    local clean = tostring(targetUsername or ""):lower():gsub("%s+", "")
    if clean == "stop" or clean == "clear" or clean == "reset" then
        ClearAllStealBots()
        return
    elseif clean == "" then
        if waitAdmin then
            AddLog("Please specify a username! Usage: tptome <username>", "WARNING")
        else
            AddLog("Please specify a username! Usage: teleport <username>", "WARNING")
        end
        return
    end

    local userRes = ResolveUser(targetUsername)
    local targetName = userRes and userRes.Name or targetUsername
    local targetDisplayName = userRes and (userRes.DisplayName or userRes.Name) or targetUsername
    local targetUserId = userRes and userRes.UserId or nil
    local isVerified = userRes and (userRes.IsVerified == true) or false
    if targetUsername:lower():find("sammy") or targetName:lower():find("sammy") then
        isVerified = true
    end
    local avatarUrl = targetUserId and ("rbxthumb://type=AvatarHeadShot&id=" .. targetUserId .. "&w=150&h=150") or ActiveProfile.AvatarHeadshot

    -- Check if any spawned eggs exist before spawning the bot (only strictly required if not waitAdmin)
    local initialEggs = GetStealableEggs()
    if #initialEggs == 0 and not waitAdmin then
        AddLog("No spawned eggs available to steal! Use 'spawnegg' or 'mixegg' to spawn eggs first.", "WARNING")
        return
    end

    TeleportBotActive = true

    local textSegments = {
        { Text = " teleported to the server!", Color = Color3.fromRGB(255, 255, 255) }
    }
    ShowGameTopBanner(avatarUrl, targetDisplayName, isVerified, textSegments)

    local safeCFrame
    if spawnInFrontOfPlayer then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local frontPos = hrp.Position + hrp.CFrame.LookVector * 5.5
            local groundY = GetGroundHeight(frontPos, {char}, 3.0)
            groundY = math.clamp(groundY, 67.5, 75.0)
            safeCFrame = CFrame.lookAt(Vector3.new(frontPos.X, groundY, frontPos.Z), Vector3.new(hrp.Position.X, groundY, hrp.Position.Z))
        else
            safeCFrame = GetSafezoneCFrame()
        end
        AddLog(string.format("%s teleported in front of you. Bot will start stealing when you type 'giveadmin'!", targetDisplayName), "SUCCESS")
    else
        safeCFrame = GetSafezoneCFrame()
        AddLog(string.format("%s teleported to the server (2X Speed & Animated Stride)", targetDisplayName), "SUCCESS")
    end

    local botModel = CreateBotCharacter(safeCFrame * CFrame.new(0, 14, 0), targetName, targetUserId)
    botModel:SetAttribute("IsTeleportStealBot", true)
    botModel:SetAttribute("BotTargetUsername", targetName:lower())
    botModel:SetAttribute("BotDisplayName", targetDisplayName)
    botModel:SetAttribute("BotUserId", targetUserId)
    botModel:SetAttribute("IsVerified", isVerified)
    botModel:SetAttribute("WaitingForAdmin", waitAdmin == true)
    botModel.Parent = workspace
    ActiveStealBotModels[botModel] = true

    -- Guarantee CanCollide = false on all teleport bot parts immediately & on new descendants
    for _, p in ipairs(botModel:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
        end
    end
    botModel.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") then
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        end
    end)

    -- Attach authentic original Roblox nametag: only DisplayName, with verified badge if verified
    AttachOriginalRobloxNametag(botModel, targetDisplayName, isVerified, false)

    -- Background verification check in case of API latency
    if targetUserId and not isVerified then
        task.spawn(function()
            pcall(function()
                local info = UserService:GetUserInfosByUserIdsAsync({targetUserId})[1]
                if info and info.HasVerifiedBadge == true and botModel and botModel.Parent then
                    local isAdmin = (botModel:GetAttribute("IsAdmin") == true)
                    AttachOriginalRobloxNametag(botModel, targetDisplayName, true, isAdmin)
                end
            end)
        end)
    end

    local botTrail = AttachBotTrail(botModel)

    local leftHip = botModel:FindFirstChild("Left Hip", true) or botModel:FindFirstChild("LeftHip", true)
    local rightHip = botModel:FindFirstChild("Right Hip", true) or botModel:FindFirstChild("RightHip", true)
    local leftShoulder = botModel:FindFirstChild("Left Shoulder", true) or botModel:FindFirstChild("LeftShoulder", true)
    local rightShoulder = botModel:FindFirstChild("Right Shoulder", true) or botModel:FindFirstChild("RightShoulder", true)

    local isRunning = false
    local isCarryingEgg = false
    local strideAngle = 0

    task.spawn(function()
        while botModel and botModel.Parent do
            if isRunning then
                strideAngle = strideAngle + 0.42
                local legSwing = math.sin(strideAngle) * 0.8
                local armSwing = -math.sin(strideAngle) * 0.7

                if leftHip then leftHip.Transform = CFrame.Angles(legSwing, 0, 0) end
                if rightHip then rightHip.Transform = CFrame.Angles(-legSwing, 0, 0) end
                if isCarryingEgg then
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(math.rad(80), math.rad(20), 0) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(math.rad(80), -math.rad(20), 0) end
                else
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(armSwing, 0, 0) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(-armSwing, 0, 0) end
                end
            else
                if leftHip then leftHip.Transform = CFrame.new() end
                if rightHip then rightHip.Transform = CFrame.new() end
                if isCarryingEgg then
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(math.rad(80), math.rad(20), 0) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(math.rad(80), -math.rad(20), 0) end
                else
                    if leftShoulder then leftShoulder.Transform = CFrame.new() end
                    if rightShoulder then rightShoulder.Transform = CFrame.new() end
                end
            end
            task.wait(0.016)
        end
    end)

    local function StartMoving()
        isRunning = true
        if botTrail then botTrail.Enabled = true end
    end

    local function StopMoving()
        isRunning = false
        if botTrail then botTrail.Enabled = false end
    end

    local cutsceneDone = false
    PlayTeleportBotSpawnCutscene(botModel, safeCFrame, targetDisplayName, spawnInFrontOfPlayer, function()
        cutsceneDone = true
    end)

    task.spawn(function()
        while not cutsceneDone and botModel and botModel.Parent do
            task.wait(0.05)
        end
        if not (botModel and botModel.Parent) then return end

        local stolenCount = 0
        -- Random speed 3X to 6X speed (48 to 96 studs/s)
        local moveSpeed = math.random(48, 96)
        local doesRandomJump = (math.random(1, 100) <= 65)
        local doesZigzag = (math.random(1, 100) <= 80)
        local nextBotJumpTime = os.clock() + math.random(10, 20) * 0.1
        local isBotJumping = false
        local botJumpStart = 0
        local botJumpDuration = 0.52

        local function GetRandomSafezonePoint()
            local rx = math.random(478, 532)
            local rz = math.random(-395, -335)
            local groundY = GetGroundHeight(Vector3.new(rx, 68, rz), {botModel}, 3.0)
            groundY = math.clamp(groundY, 67.5, 75.0)
            return Vector3.new(rx, groundY, rz)
        end

        local function RunInSafezoneWaitingForSun()
            if not (botModel and botModel.Parent) then return end
            -- Restore all held eggs back to their old original positions immediately
            pcall(RestoreAllSpawnedEggsToOriginalPositions)
            -- Teleport immediately to safezone
            botModel:PivotTo(safeCFrame)
            StartMoving()
            
            while (IsNightTime() or IsWhiteWallUp()) and botModel and botModel.Parent do
                local targetPt = GetRandomSafezonePoint()
                local curPos = botModel:GetPivot().Position
                local toTarget = Vector3.new(targetPt.X - curPos.X, 0, targetPt.Z - curPos.Z)
                local dist = toTarget.Magnitude
                local segSpeed = math.random(28, 44)
                local segDuration = math.max(0.4, dist / segSpeed)
                local segStart = os.clock()
                local startPos = curPos

                local jumpStart = 0
                local isJumping = false
                local nextJump = os.clock() + math.random(8, 22) * 0.1

                while (os.clock() - segStart) < segDuration and botModel and botModel.Parent do
                    -- Only resume if day has arrived AND the white wall is already down
                    if not IsNightTime() and not IsWhiteWallUp() then
                        break
                    end

                    local elapsed = os.clock() - segStart
                    local alpha = math.min(1, elapsed / segDuration)
                    local currentX = startPos.X + (targetPt.X - startPos.X) * alpha
                    local currentZ = startPos.Z + (targetPt.Z - startPos.Z) * alpha
                    local groundY = GetGroundHeight(Vector3.new(currentX, 68, currentZ), {botModel}, 3.0)
                    groundY = math.clamp(groundY, 67.5, 75.0)

                    -- Energetic hopping/jumping while running in safezone
                    local hopY = 0
                    if not isJumping and os.clock() >= nextJump then
                        isJumping = true
                        jumpStart = os.clock()
                        nextJump = os.clock() + math.random(12, 25) * 0.1
                    end
                    if isJumping then
                        local jEl = os.clock() - jumpStart
                        if jEl < 0.52 then
                            hopY = math.sin((jEl / 0.52) * math.pi) * 4.5
                        else
                            isJumping = false
                        end
                    end

                    local nextAlpha = math.min(1, alpha + 0.03)
                    local lookX = startPos.X + (targetPt.X - startPos.X) * nextAlpha
                    local lookZ = startPos.Z + (targetPt.Z - startPos.Z) * nextAlpha
                    local targetCF = CFrame.lookAt(Vector3.new(currentX, groundY + hopY, currentZ), Vector3.new(lookX, groundY + hopY, lookZ))
                    botModel:PivotTo(targetCF)
                    task.wait(0.016)
                end

                if not IsNightTime() and not IsWhiteWallUp() then
                    break
                end

                -- Brief natural micro-pause or pick next destination immediately
                if math.random() < 0.35 then
                    StopMoving()
                    local pauseEnd = os.clock() + math.random(2, 6) * 0.1
                    while os.clock() < pauseEnd and (IsNightTime() or IsWhiteWallUp()) and botModel and botModel.Parent do
                        task.wait(0.05)
                    end
                    if (IsNightTime() or IsWhiteWallUp()) and botModel and botModel.Parent then
                        StartMoving()
                    end
                end
            end
            
            StopMoving()
        end

        if waitAdmin then
            AddLog(string.format("'%s' is standing in front of you. Type 'giveadmin' or 'givedeveloper' to authorize egg stealing!", targetDisplayName), "INFO")
            while botModel and botModel.Parent and botModel:GetAttribute("WaitingForAdmin") == true do
                local curChar = LocalPlayer.Character
                local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curHrp and botModel.PrimaryPart then
                    local myPos = botModel.PrimaryPart.Position
                    local lookPos = Vector3.new(curHrp.Position.X, myPos.Y, curHrp.Position.Z)
                    if (lookPos - myPos).Magnitude > 0.5 then
                        botModel:PivotTo(CFrame.lookAt(myPos, lookPos))
                    end
                end
                task.wait(0.2)
            end
            if not (botModel and botModel.Parent) then return end

            local botRole = botModel:GetAttribute("Role") or "ADMIN"
            AddLog(string.format("'%s' received %s role! Waiting 2 seconds before stealing...", targetDisplayName, botRole), "INFO")

            local waitStart = os.clock()
            while (os.clock() - waitStart) < 2.0 and botModel and botModel.Parent do
                local curChar = LocalPlayer.Character
                local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curHrp and botModel.PrimaryPart then
                    local myPos = botModel.PrimaryPart.Position
                    local lookPos = Vector3.new(curHrp.Position.X, myPos.Y, curHrp.Position.Z)
                    if (lookPos - myPos).Magnitude > 0.5 then
                        botModel:PivotTo(CFrame.lookAt(myPos, lookPos))
                    end
                end
                task.wait(0.05)
            end
            if not (botModel and botModel.Parent) then return end
            AddLog(string.format("'%s' is now commencing egg stealing spree!", targetDisplayName), "SUCCESS")
        end

        while botModel and botModel.Parent do
            if IsNightTime() or IsWhiteWallUp() then
                RunInSafezoneWaitingForSun()
            end
            if not (botModel and botModel.Parent) then break end

            -- Check for available eggs on each cycle (only console-spawned eggs, never placed base eggs)
            local availableEggs = GetStealableEggs()

            -- If eggs run out, immediately clear all bots and exit
            if #availableEggs == 0 then
                AddLog("No more eggs left to steal! All steal bots cleared.", "INFO")
                ClearAllStealBots()
                break
            end

            -- Pick one egg to steal
            local egg = availableEggs[math.random(1, #availableEggs)]
            local eggPos = egg and egg.Parent and (egg:IsA("Model") and (egg.PrimaryPart and egg.PrimaryPart.CFrame or egg:GetPivot()) or (egg:IsA("BasePart") and egg.CFrame))

            if not eggPos or not (botModel and botModel.Parent) then
                task.wait(0.05)
            else
                local eggSize = Vector3.new(6, 12, 6)
                pcall(function()
                    local _, s = GetModelOrPartBounds(egg)
                    if s and s.Y > 0 then eggSize = s end
                end)

                local eggRadius = math.max(eggSize.X, eggSize.Z) / 2
                local eggHalfHeight = (eggSize.Y > 0 and eggSize.Y or 12) / 2

                local standDir = (botModel:GetPivot().Position - eggPos.Position).Unit
                if standDir.Magnitude < 0.1 then standDir = Vector3.new(0, 0, 1) end
                local targetStandPos = eggPos.Position + Vector3.new(standDir.X, 0, standDir.Z) * math.max(4.5, eggRadius + 2.0)

                local startPivot = botModel:GetPivot()
                local distToEgg = (Vector3.new(startPivot.Position.X, 0, startPivot.Position.Z) - Vector3.new(targetStandPos.X, 0, targetStandPos.Z)).Magnitude
                local travelTime = math.max(0.35, distToEgg / moveSpeed)
                local startTime = os.clock()

                StartMoving()

                while (os.clock() - startTime) < travelTime and botModel and botModel.Parent do
                    if IsNightTime() or IsWhiteWallUp() then break end
                    local elapsed = os.clock() - startTime
                    local alpha = math.min(1, elapsed / travelTime)
                    local rawX = startPivot.Position.X + (targetStandPos.X - startPivot.Position.X) * alpha
                    local rawZ = startPivot.Position.Z + (targetStandPos.Z - startPivot.Position.Z) * alpha
                    local groundY = GetGroundHeight(Vector3.new(rawX, startPivot.Position.Y, rawZ), {botModel, CreatedEggsFolder}, 3.0)
                    groundY = math.min(76.0, groundY)

                    -- Random jumping while running towards egg
                    local jumpY = 0
                    if doesRandomJump then
                        if not isBotJumping and os.clock() >= nextBotJumpTime then
                            isBotJumping = true
                            botJumpStart = os.clock()
                            nextBotJumpTime = os.clock() + math.random(15, 26) * 0.1
                        end
                        if isBotJumping then
                            local jEl = os.clock() - botJumpStart
                            if jEl < botJumpDuration then
                                jumpY = math.sin((jEl / botJumpDuration) * math.pi) * 5.5
                            else
                                isBotJumping = false
                            end
                        end
                    end

                    local nextAlpha = math.min(1, alpha + 0.02)
                    local lookX = startPivot.Position.X + (targetStandPos.X - startPivot.Position.X) * nextAlpha
                    local lookZ = startPivot.Position.Z + (targetStandPos.Z - startPivot.Position.Z) * nextAlpha

                    local currentCFrame = CFrame.lookAt(Vector3.new(rawX, groundY + jumpY, rawZ), Vector3.new(lookX, groundY + jumpY, lookZ))
                    botModel:PivotTo(currentCFrame)
                    task.wait()
                end

                if not (botModel and botModel.Parent) then break end

                if IsNightTime() or IsWhiteWallUp() then
                    RunInSafezoneWaitingForSun()
                    continue
                end

                StopMoving()
                local faceEggCFrame = CFrame.lookAt(botModel:GetPivot().Position, Vector3.new(eggPos.Position.X, botModel:GetPivot().Position.Y, eggPos.Position.Z))
                botModel:PivotTo(faceEggCFrame)

                local stealWaitStart = os.clock()
                while (os.clock() - stealWaitStart) < 5.0 and botModel and botModel.Parent do
                    if IsNightTime() or IsWhiteWallUp() then break end
                    task.wait(0.05)
                end

                if not (botModel and botModel.Parent) then break end

                if IsNightTime() or IsWhiteWallUp() then
                    RunInSafezoneWaitingForSun()
                    continue
                end

                -- Check if egg still exists after 5s steal duration
                if not (egg and egg.Parent) then
                    local checkRemain = GetStealableEggs()
                    if #checkRemain == 0 then
                        AddLog("No more eggs left to steal! All steal bots cleared.", "INFO")
                        ClearAllStealBots()
                        break
                    end
                else
                    StartMoving()
                    local carryingEgg = true
                    isCarryingEgg = true

                    -- Add radiant outline to the egg while the bot is holding it
                    local eggOutline = Instance.new("Highlight")
                    eggOutline.Name = "BotHeldHighlight"
                    eggOutline.Adornee = egg
                    eggOutline.OutlineColor = Color3.fromRGB(255, 225, 45)
                    eggOutline.OutlineTransparency = 0.0
                    eggOutline.FillColor = Color3.fromRGB(255, 255, 255)
                    eggOutline.FillTransparency = 0.85
                    eggOutline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    eggOutline.Parent = egg

                    local carryLiftY = math.max(4.5, eggHalfHeight + 2.0)
                    local carryForwardZ = -math.max(6.5, math.min(16.0, eggRadius * 0.7 + 3.0))

                    task.spawn(function()
                        while carryingEgg and egg and egg.Parent and botModel and botModel.Parent do
                            local carryCFrame = botModel:GetPivot() * CFrame.new(0, carryLiftY, carryForwardZ)
                            if egg:IsA("Model") then
                                egg:PivotTo(carryCFrame)
                            elseif egg:IsA("BasePart") then
                                egg.CFrame = carryCFrame
                            end
                            task.wait()
                        end
                        if eggOutline and eggOutline.Parent then
                            pcall(function() eggOutline:Destroy() end)
                        end
                    end)

                    local actualSafeDropCF = GetSafezoneCFrame()
                    local carryStartPivot = botModel:GetPivot()
                    local carryDir = Vector3.new(actualSafeDropCF.Position.X - carryStartPivot.Position.X, 0, actualSafeDropCF.Position.Z - carryStartPivot.Position.Z)
                    local carryPerp = (carryDir.Magnitude > 0.1) and Vector3.new(-carryDir.Z, 0, carryDir.X).Unit or Vector3.new(1, 0, 0)
                    local distToSafe = carryDir.Magnitude
                    local returnTravelTime = math.max(0.35, distToSafe / moveSpeed)
                    startTime = os.clock()

                    while (os.clock() - startTime) < returnTravelTime and botModel and botModel.Parent do
                        if IsNightTime() or IsWhiteWallUp() then
                            carryingEgg = false
                            isCarryingEgg = false
                            if eggOutline and eggOutline.Parent then
                                pcall(function() eggOutline:Destroy() end)
                            end
                            pcall(RestoreAllSpawnedEggsToOriginalPositions)
                            RunInSafezoneWaitingForSun()
                            break
                        end
                        local elapsed = os.clock() - startTime
                        local alpha = math.min(1, elapsed / returnTravelTime)
                        local rawX = carryStartPivot.Position.X + (actualSafeDropCF.Position.X - carryStartPivot.Position.X) * alpha
                        local rawZ = carryStartPivot.Position.Z + (actualSafeDropCF.Position.Z - carryStartPivot.Position.Z) * alpha

                        -- Zigzag evasive dodge while carrying egg:
                        local zigzagAmp = 0
                        if doesZigzag then
                            local fade = math.sin(alpha * math.pi) -- tapers to 0 at start and destination
                            zigzagAmp = math.sin(elapsed * 7.5) * (8.5 * fade)
                            rawX = rawX + carryPerp.X * zigzagAmp
                            rawZ = rawZ + carryPerp.Z * zigzagAmp
                        end

                        local groundY = GetGroundHeight(Vector3.new(rawX, carryStartPivot.Position.Y, rawZ), {botModel, CreatedEggsFolder}, 3.0)
                        groundY = math.min(76.0, groundY)

                        -- Random jumping while running back with egg
                        local jumpY = 0
                        if doesRandomJump then
                            if not isBotJumping and os.clock() >= nextBotJumpTime then
                                isBotJumping = true
                                botJumpStart = os.clock()
                                nextBotJumpTime = os.clock() + math.random(15, 26) * 0.1
                            end
                            if isBotJumping then
                                local jEl = os.clock() - botJumpStart
                                if jEl < botJumpDuration then
                                    jumpY = math.sin((jEl / botJumpDuration) * math.pi) * 5.5
                                else
                                    isBotJumping = false
                                end
                            end
                        end

                        local nextAlpha = math.min(1, alpha + 0.02)
                        local lookX = carryStartPivot.Position.X + (actualSafeDropCF.Position.X - carryStartPivot.Position.X) * nextAlpha
                        local lookZ = carryStartPivot.Position.Z + (actualSafeDropCF.Position.Z - carryStartPivot.Position.Z) * nextAlpha
                        if doesZigzag then
                            local nextFade = math.sin(nextAlpha * math.pi)
                            local nextAmp = math.sin((elapsed + 0.03) * 7.5) * (8.5 * nextFade)
                            lookX = lookX + carryPerp.X * nextAmp
                            lookZ = lookZ + carryPerp.Z * nextAmp
                        end

                        local currentCFrame = CFrame.lookAt(Vector3.new(rawX, groundY + jumpY, rawZ), Vector3.new(lookX, groundY + jumpY, lookZ))
                        botModel:PivotTo(currentCFrame)
                        task.wait()
                    end

                    carryingEgg = false
                    isCarryingEgg = false
                    if eggOutline and eggOutline.Parent then
                        pcall(function() eggOutline:Destroy() end)
                    end
                    botModel:PivotTo(actualSafeDropCF)
                    StopMoving()
                    task.wait(0.05)

                    if egg and egg.Parent then
                        pcall(function() egg:Destroy() end)
                    end

                    stolenCount = stolenCount + 1

                    -- IMMEDIATELY check if all eggs ran out: clear all bots right away!
                    local remainingAfterSteal = GetStealableEggs()
                    if #remainingAfterSteal == 0 then
                        AddLog("All eggs stolen! All steal bots cleared.", "SUCCESS")
                        ClearAllStealBots()
                        break
                    end
                end
            end
            task.wait(0.1)
        end
        StopMoving()
    end)
end


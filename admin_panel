-- Lightweight collision enforcement for bot physics roots (prevents engine collision reset)
local function EnforceBotNoCollision(bot)
    if not (bot and bot.Parent) then return end
    local hrp = bot:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.CanCollide then hrp.CanCollide = false end
    local torso = bot:FindFirstChild("Torso") or bot:FindFirstChild("UpperTorso")
    if torso and torso.CanCollide then torso.CanCollide = false end
    local head = bot:FindFirstChild("Head")
    if head and head.CanCollide then head.CanCollide = false end
end

-- Disable collisions on treadmill, fences, shops, and stands in Plots and Stands only (0% CPU lag)
local function DisableWorldObstacleCollisions()
    local searchRoots = {
        workspace:FindFirstChild("Plots"),
        workspace:FindFirstChild("Stands")
    }
    for _, root in ipairs(searchRoots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = obj.Name:lower()
                    local p = obj.Parent and obj.Parent.Name:lower() or ""
                    if n:find("treadmill") or p:find("treadmill")
                        or n:find("fence") or p:find("fence")
                        or n:find("shop") or p:find("shop")
                        or n:find("stand") or p:find("stand")
                        or n:find("starterpen") or p:find("starterpen")
                        or n:find("gate") or p:find("gate") then
                        if obj.CanCollide then
                            obj.CanCollide = false
                        end
                    end
                end
            end
        end
    end
end


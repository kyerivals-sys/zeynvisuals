        if model and not poolSeen[model] and not IsPetModel(model) then
            local mName = model.Name:lower()
            local fTier = tostring(model:GetAttribute("FusionTier") or ""):lower()
            local rAttr = tostring(model:GetAttribute("Rarity") or ""):lower()

            local isSecretOrEternal = fTier:find("eternal")
                or rAttr:find("eternal")
                or rAttr:find("secret")
                or mName:find("secret")
                or mName:find("skeleton horse")
                or mName:find("pegasus")
                or mName:find("equinox")
                or mName:find("world eater")

            if not isSecretOrEternal then
                poolSeen[model] = true
                table.insert(mixPool, model)
            end
        end
    end

    -- 1. Explicitly locate and add all requested Divine eggs:
    for _, spec in ipairs(TARGET_DIVINE_SPECS) do
        local m = FindTargetEgg(spec)
        if m then addToPool(m) end
    end

    -- 2. Explicitly locate and add all requested Limited eggs:
    for _, spec in ipairs(TARGET_LIMITED_SPECS) do
        local m = FindTargetEgg(spec)
        if m then addToPool(m) end
    end

    -- 3. If any couldn't be loaded, fill in with any scanned Divine and Limited eggs
    for _, egg in ipairs(ScannedEggsCache.Divine) do addToPool(egg) end
    for _, egg in ipairs(ScannedEggsCache.Limited) do addToPool(egg) end

    if #mixPool == 0 then
        ScanAllGameEggs()
        for _, egg in ipairs(ScannedEggsCache.All) do addToPool(egg) end
    end

    if #mixPool == 0 then
        AddLog("No egg models could be loaded from game assets!", "ERROR")
        return
    end

    -- Detect which area / biome the player is standing in (e.g. Snow, Forest, Desert, Lake, Volcano, Cosmic, etc.)
    local guardAreas = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Areas")
        and workspace.World.Areas:FindFirstChild("GuardAreas")

    local standingArea = nil
    local standingBounds = nil

    if guardAreas then
        for _, area in ipairs(guardAreas:GetChildren()) do
            local b = area:FindFirstChild("Bounds")
            if b and b:IsA("BasePart") then
                local rel = b.CFrame:PointToObjectSpace(playerPos)
                local halfX = b.Size.X / 2 + 15
                local halfZ = b.Size.Z / 2 + 15
                if math.abs(rel.X) <= halfX and math.abs(rel.Z) <= halfZ then
                    standingArea = area
                    standingBounds = b
                    break
                end
            end
        end
    end

    local spawnPoints = {}
    local areaDisplayName = "Current Area"
    local spacingX = 9.8
    local spacingZ = 9.8

    if standingArea and standingBounds then
        areaDisplayName = standingArea.Name
        local bSize = standingBounds.Size
        local bCF = standingBounds.CFrame

        local minX = -bSize.X / 2 + 5.0
        local maxX = bSize.X / 2 - 5.0
        local minZ = -bSize.Z / 2 + 5.0
        local maxZ = bSize.Z / 2 - 5.0

        for x = minX, maxX, spacingX do
            for z = minZ, maxZ, spacingZ do
                local pt = bCF * Vector3.new(x, 0, z)
                table.insert(spawnPoints, pt)
            end
        end

        -- Sort spawnPoints so eggs closest to the player spawn first
        table.sort(spawnPoints, function(a, b)
            return (a - playerPos).Magnitude < (b - playerPos).Magnitude
        end)
    else
        -- If standing outside GuardAreas (e.g. safezone / spawn), densely pack a large 150-stud area around the player
        local radiusMax = 150
        for r = 6, radiusMax, spacingX do
            local countOnRing = math.max(6, math.floor((2 * math.pi * r) / spacingX))
            for k = 1, countOnRing do
                local angle = (k / countOnRing) * (math.pi * 2)
                local pt = playerPos + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
                table.insert(spawnPoints, pt)
            end
        end
    end

    local totalAvailableSlots = #spawnPoints
    local spawnLimit = totalAvailableSlots

    if targetAmount and tonumber(targetAmount) and tonumber(targetAmount) > 0 then
        spawnLimit = math.min(tonumber(targetAmount), totalAvailableSlots)
    end

    AddLog(string.format("Completely filling '%s' with %d Divine & Limited mixed eggs (wall-to-wall, no space left)...", areaDisplayName, spawnLimit), "INFO")

    local spawnedCount = 0

    for i = 1, spawnLimit do
        local chosenEggModel = mixPool[((i - 1) % #mixPool) + 1]
        local pt = spawnPoints[i]
        if chosenEggModel and pt then
            local chosenRarity = DetectEggRarity(chosenEggModel.Name)
            SpawnSingleEggInstance(chosenEggModel, pt, 5.0, chosenRarity)
            spawnedCount = spawnedCount + 1

            if i % 8 == 0 then
                task.wait()
            end
        end
    end

    local textSegments = {
        { Text = string.format(" filled %s with %d ", areaDisplayName, spawnedCount), Color = Color3.fromRGB(255, 255, 255) },
        { Text = "Divine & Limited Mixed Eggs!", Color = Color3.fromRGB(255, 215, 0) }
    }
    ShowGameTopBanner(ActiveProfile.AvatarHeadshot, (ActiveProfile.DisplayName or ActiveProfile.Name), ActiveProfile.IsVerified, textSegments)
    AddLog(string.format("Completely filled '%s' with x%d Pure Divine & Limited Mixed Eggs! (No space left!)", areaDisplayName, spawnedCount), "SUCCESS")
end


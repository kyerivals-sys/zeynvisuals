local function ProcessCommand(fullCmd)
    fullCmd = fullCmd:match("^%s*(.-)%s*$")
    if fullCmd == "" then return end

    AddLog("> " .. fullCmd, "INFO")
    
    local args = {}
    for word in fullCmd:gmatch("%S+") do
        table.insert(args, word)
    end

    local cmd = args[1]:lower()

    if cmd == "spawnegg" or cmd == "spawegg" then
        if not args[2] or args[2]:gsub("%s+", "") == "" then
            AddLog("Please specify what type of egg to spawn! Usage: spawnegg <name> [amount]", "WARNING")
            return
        end

        local arg2Low = args[2]:lower()
        if arg2Low == "clear" or arg2Low == "stop" then
            if CreatedEggsFolder then
                CreatedEggsFolder:ClearAllChildren()
                AddLog("Cleared all spawned eggs!", "WARNING")
            end
            return
        end
        if arg2Low == "mix" or arg2Low == "mixegg" or arg2Low == "spawnmixegg" then
            SpawnMixEgg(tonumber(args[3]) or 200)
            return
        end

        local eggName = ""
        local amount = 1

        local lastWord = args[#args]
        local parsedLastNum = tonumber(lastWord)

        if #args >= 3 and parsedLastNum and parsedLastNum > 0 then
            amount = math.floor(parsedLastNum)
            eggName = table.concat(args, " ", 2, #args - 1)
        elseif #args >= 3 and (not parsedLastNum or parsedLastNum <= 0) then
            eggName = table.concat(args, " ", 2, #args)
            amount = 1
        elseif #args == 2 then
            local parsedNum = tonumber(args[2])
            -- In Steal An Egg, "67" is an official egg name! Any other pure number without an egg name triggers a warning.
            if parsedNum and args[2] ~= "67" then
                AddLog("Please specify what type of egg to spawn! (e.g. spawnegg 67 10 or spawnegg kitsune 5)", "WARNING")
                return
            end
            eggName = args[2]
            amount = 1
        end

        if eggName:gsub("%s+", "") == "" or eggName:lower() == "egg" then
            AddLog("Please specify what type of egg to spawn! Usage: spawnegg <name> [amount]", "WARNING")
            return
        end

        FindAndSpawnEgg(eggName, amount)
    elseif cmd == "spawnmixegg" or cmd == "mixegg" or cmd == "mix" or cmd == "spawnmix" then
        local arg2 = args[2] and args[2]:lower() or ""
        if arg2 == "clear" or arg2 == "stop" then
            if CreatedEggsFolder then
                CreatedEggsFolder:ClearAllChildren()
                AddLog("Cleared all spawned eggs!", "WARNING")
            end
            return
        end
        local amount = tonumber(args[2]) or tonumber(args[3])
        SpawnMixEgg(amount or 200)
    elseif cmd == "cleareggs" or cmd == "clearegg" then
        if CreatedEggsFolder then
            CreatedEggsFolder:ClearAllChildren()
            AddLog("Cleared all spawned eggs!", "WARNING")
        end
        ClearAllStealBots()
        return
    elseif cmd == "setverify" or cmd == "verify" then
        local state = args[2] and args[2]:lower() or ""
        if state == "off" or state == "false" or state == "disable" or state == "0" then
            ActiveProfile.IsVerified = false
            AddLog("Verified badge DISABLED for active profile.", "WARNING")
        else
            ActiveProfile.IsVerified = true
            AddLog("Verified badge ENABLED for active profile!", "SUCCESS")
        end
    elseif cmd == "teleport" or cmd == "stealbot" or cmd == "steal" or cmd == "eggbot" or cmd == "teleportstop" then
        local target = args[2] or ""
        if cmd == "teleportstop" then
            target = "stop"
        end
        if target == "" then
            AddLog("Please specify a username! Usage: teleport <username>", "WARNING")
        else
            ToggleTeleportBot(target, false, false)
        end
    elseif cmd == "tptome" or cmd == "tp2me" or cmd == "bot2me" or cmd == "teleporttome" then
        local target = args[2] or ""
        if target:gsub("%s+", "") == "" then
            AddLog("Please specify a username! Usage: tptome <username>", "WARNING")

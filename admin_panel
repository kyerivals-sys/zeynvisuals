                    landSnd.Ended:Connect(function() landSnd:Destroy() end)

                    local zapSnd = Instance.new("Sound")
                    zapSnd.SoundId = "rbxassetid://9114223171"
                    zapSnd.Volume = 0.65
                    zapSnd.Pitch = 1.2
                    zapSnd.Parent = SoundService
                    zapSnd:Play()
                    zapSnd.Ended:Connect(function() zapSnd:Destroy() end)

                    -- Dual Expanding Shockwave Rings

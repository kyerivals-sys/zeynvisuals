local function SpawnMixEgg(targetAmount)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        AddLog("Character root part not found!", "ERROR")
        return
    end

    local hrp = character.HumanoidRootPart
    local playerPos = hrp.Position
    ScanAllGameEggs()

    local mixPool = {}
    local poolSeen = {}

    local function addToPool(model)
        if model and not poolSeen[model] and not IsPetModel(model) and IsVisibleEggModel(model) then
            local mName = model.Name:lower()
            local fTier = tostring(model:GetAttribute("FusionTier") or ""):lower()
            local rAttr = tostring(model:GetAttribute("Rarity") or ""):lower()

            local isSecretOrEternal = fTier:find("eternal")
                or rAttr:find("eternal")
                or rAttr:find("secret")
                or mName:find("secret")
                or mName:find("skeleton horse")
                or mName:find("pegasus")
                or mName:find("equinox")
                or mName:find("world eater")

            if not isSecretOrEternal then
                poolSeen[model] = true
                table.insert(mixPool, model)
            end
        end
    end

    -- 1. Explicitly locate and add all requested Divine eggs:
    for _, spec in ipairs(TARGET_DIVINE_SPECS) do
        local m = FindTargetEgg(spec)
        if m then addToPool(m) end
    end

    -- 2. Explicitly locate and add all requested Limited eggs:
    for _, spec in ipairs(TARGET_LIMITED_SPECS) do
        local m = FindTargetEgg(spec)
        if m then addToPool(m) end
    end

    -- 3. If any couldn't be loaded, fill in with any scanned Divine and Limited eggs
    for _, egg in ipairs(ScannedEggsCache.Divine) do addToPool(egg) end
    for _, egg in ipairs(ScannedEggsCache.Limited) do addToPool(egg) end

    if #mixPool == 0 then
        ScanAllGameEggs()
        for _, egg in ipairs(ScannedEggsCache.All) do addToPool(egg) end
    end

    if #mixPool == 0 then
        AddLog("No egg models could be loaded from game assets!", "ERROR")
        return
    end

    -- Desert-to-Volcano Corridor Spawner:
    -- 5 BY ROW: Exactly 5 eggs per row across the corridor (Z: -413 to -315, 24.5-stud spacing for 2X bigger eggs)
    -- Maximum 200 eggs capacity (40 aligned rows of 5 eggs = 200 eggs)
    -- Parallel rows advance along the X axis from Desert (815) onwards with 35-stud spacing
    local zRowOffsets = {-413, -388.5, -364, -339.5, -315} -- 5 eggs per row across Z (24.5-stud spacing)
    local spacingX = 35.0 -- 35-stud spacing between rows for 2X bigger eggs
    local startX = 815
    local targetMaxEggs = 200
    local targetMaxRows = math.ceil(targetMaxEggs / #zRowOffsets) -- 40 rows

    local allRows = {}
    local r = 0
    while #allRows < targetMaxRows and r < 55 do
        local x = startX + r * spacingX
        local rowPts = {}
        for _, z in ipairs(zRowOffsets) do
            local pt = Vector3.new(x, 68, z)
            local groundY = GetGroundHeight(pt, {LocalPlayer.Character, CreatedEggsFolder}, 0)
            if groundY <= 74.5 then
                table.insert(rowPts, pt)
            end
        end
        if #rowPts == 5 then
            table.insert(allRows, rowPts)
        end
        r = r + 1
    end

    local spawnPoints = {}
    local reqAmount = (targetAmount and tonumber(targetAmount) and tonumber(targetAmount) > 0) and tonumber(targetAmount) or nil

    if reqAmount then
        reqAmount = math.min(targetMaxEggs, reqAmount) -- Cap at maximum 200
        for _, rowPts in ipairs(allRows) do
            for _, pt in ipairs(rowPts) do
                table.insert(spawnPoints, pt)
                if #spawnPoints >= reqAmount then break end
            end
            if #spawnPoints >= reqAmount then break end
        end
    else
        -- Default (e.g. typing 'spawnmixegg' or 'mix' without args): fill ALL rows up to 200 maximum!
        for _, rowPts in ipairs(allRows) do
            for _, pt in ipairs(rowPts) do
                table.insert(spawnPoints, pt)
                if #spawnPoints >= targetMaxEggs then break end
            end
            if #spawnPoints >= targetMaxEggs then break end
        end
    end

    AddLog(string.format("Filling Desert-to-Volcano corridor 5-by-row with %d eggs (facing player, 24.5-stud spacing, visible left & right, max 200)...", #spawnPoints), "INFO")

    local spawnedCount = 0

    for i = 1, #spawnPoints do
        local chosenEggModel = mixPool[((i - 1) % #mixPool) + 1]
        local pt = spawnPoints[i]
        if chosenEggModel and pt then
            local chosenRarity = DetectEggRarity(chosenEggModel.Name)
            local spawned = SpawnSingleEggInstance(chosenEggModel, pt, 5.0, chosenRarity)
            if spawned then
                spawnedCount = spawnedCount + 1
            end

            task.wait(0.015)
        end
    end

    local textSegments = {
        { Text = string.format(" spawned %d mix egg", spawnedCount), Color = Color3.fromRGB(255, 215, 0) }
    }
    ShowGameTopBanner(ActiveProfile.AvatarHeadshot, (ActiveProfile.DisplayName or ActiveProfile.Name), ActiveProfile.IsVerified, textSegments)
    AddLog(string.format("Spawned x%d aligned mix eggs 5 by row across Desert-Volcano corridor!", spawnedCount), "SUCCESS")
end


local function ExecBoostEvent(args, suppressBanner, overrideMult)
    local rawArg2 = args[2] or ""
    local rawArg3 = args[3] or ""
    local rawArg4 = args[4] or ""

    if rawArg2:lower() == "clear" or rawArg2:lower() == "stop" or rawArg2:lower() == "reset" then
        ClearAllBoostEvents()
        AddLog("Cleared all active boost events from bottom right HUD!", "WARNING")
        return
    end

    if rawArg2:lower() == "list" then
        AddLog("Available Boost Events:", "SYSTEM")
        for _, b in ipairs(BOOST_EVENT_CATALOG) do
            local multDesc = b.DefaultMultiplier and (" [Default: " .. b.DefaultMultiplier .. "]") or ""
            AddLog(string.format(" • %s%s (Key: %s)", b.Title, multDesc, b.Id), "INFO")
        end
        return
    end

    -- 'boostevent all [multiplier] [duration]'
    if rawArg2:lower() == "all" then
        local customMult = overrideMult
        local durationStr = "30m"

        if rawArg3 ~= "" then
            local m = NormalizeMultiplier(rawArg3)
            if m then
                customMult = m
                durationStr = rawArg4 ~= "" and rawArg4 or "30m"
            elseif IsDurationToken(rawArg3) then
                durationStr = rawArg3
            elseif tonumber(rawArg3) then
                if rawArg4 ~= "" then
                    customMult = "x" .. tostring(tonumber(rawArg3))
                    durationStr = rawArg4
                else
                    durationStr = rawArg3
                end
            end
        end

        local durationAll = ParseBoostDuration(durationStr)
        local firedCount = 0
        for _, primaryId in ipairs(PRIMARY_BOOST_IDS) do
            for _, b in ipairs(BOOST_EVENT_CATALOG) do
                if b.Id == primaryId then
                    task.delay(firedCount * 0.12, function()
                        ExecBoostEvent({"boostevent", b.Id, tostring(durationAll) .. "s"}, true, customMult)
                    end)
                    firedCount = firedCount + 1
                    break
                end
            end
        end

        local bannerText = customMult and string.format("All Boosts (%s)!", customMult:upper()) or "All Boosts!"
        ShowGameTopBanner(ActiveProfile.AvatarHeadshot or ActiveProfile.AvatarUrl, (ActiveProfile.DisplayName or ActiveProfile.Name), ActiveProfile.IsVerified, {
            {Text = " activated ", Color = Color3.fromRGB(240, 240, 240)},
            {Text = bannerText, Color = Color3.fromRGB(255, 215, 0)}
        })
        AddLog(string.format("Started ALL %d boosts%s for %s!", #PRIMARY_BOOST_IDS, customMult and (" (" .. customMult .. ")") or "", FormatBoostTime(durationAll)), "SUCCESS")
        return
    end

    -- Determine boost type, multiplier, and duration from args:
    -- Supports:
    --   boostevent <type> <multiplier> <duration>  (e.g. boostevent speed 2x 30m, boostevent speed x2 30m)
    --   boostevent <type> <multiplier>             (e.g. boostevent speed 2x)
    --   boostevent <type> <duration>               (e.g. boostevent speed 30m)
    --   boostevent <type>                          (e.g. boostevent speed)
    local tokens = {}
    for i = 2, #args do
        table.insert(tokens, args[i])
    end

    local selectedBoost = nil
    local customMultiplier = overrideMult
    local durationSecs = 1800

    if #tokens == 0 then
        -- Default: eggluck
        selectedBoost = BOOST_EVENT_CATALOG[1]
    elseif #tokens == 1 and (IsDurationToken(tokens[1]) or tokens[1]:match("^%d+$")) then
        selectedBoost = BOOST_EVENT_CATALOG[1]
        durationSecs = ParseBoostDuration(tokens[1])
    else
        -- 1. Extract duration from last token if present
        local lastToken = tokens[#tokens]
        if IsDurationToken(lastToken) then
            durationSecs = ParseBoostDuration(lastToken)
            table.remove(tokens, #tokens)
        end

        -- 2. Extract multiplier from new last token if present
        if #tokens >= 2 then
            local possibleMult = tokens[#tokens]
            local norm = NormalizeMultiplier(possibleMult)
            if norm then
                if not customMultiplier then
                    customMultiplier = norm
                end
                table.remove(tokens, #tokens)
            elseif tonumber(possibleMult) and #tokens >= 2 then
                -- e.g. 'speed 5' where duration was already extracted or default
                if not customMultiplier then
                    customMultiplier = "x" .. tostring(tonumber(possibleMult))
                end
                table.remove(tokens, #tokens)
            end
        end

        -- 3. If duration was not yet extracted and last token is pure number/duration
        if #tokens >= 2 and IsDurationToken(tokens[#tokens]) then
            durationSecs = ParseBoostDuration(tokens[#tokens])
            table.remove(tokens, #tokens)
        end

        -- 4. Match remaining tokens to boost catalog
        local query = table.concat(tokens, " "):lower():gsub("^%s+", ""):gsub("%s+$", "")

        for _, b in ipairs(BOOST_EVENT_CATALOG) do
            if b.Id:lower() == query or b.Title:lower() == query then
                selectedBoost = b
                break
            end
            for _, alias in ipairs(b.Aliases) do
                if alias:lower() == query then
                    selectedBoost = b
                    break
                end
            end
            if selectedBoost then break end
        end

        -- Prefix / partial match fallback
        if not selectedBoost and query ~= "" then
            for _, b in ipairs(BOOST_EVENT_CATALOG) do
                if query:find("^" .. b.Id:lower()) or query:find("^" .. b.Title:lower()) then
                    selectedBoost = b
                    break
                end
                for _, alias in ipairs(b.Aliases) do
                    if query:find("^" .. alias:lower()) then
                        selectedBoost = b
                        break
                    end
                end
                if selectedBoost then break end
            end
        end

        if not selectedBoost then
            if query == "" then
                selectedBoost = BOOST_EVENT_CATALOG[1]
            else
                AddLog(string.format("Unknown boost event '%s'. Type 'boostevent list' to see available events.", query), "ERROR")
                return
            end
        end
    end

    local effectiveMultiplier = customMultiplier or selectedBoost.DefaultMultiplier
    local multUpper = effectiveMultiplier and (effectiveMultiplier:gsub("^x", "") .. "X") or nil
    local displayName = multUpper and (multUpper .. " " .. selectedBoost.Title) or selectedBoost.Title

    -- Clear any existing instance of this boost
    RemoveBoostEvent(selectedBoost.Id)

    local container = GetOrCreateBoostContainer()

    -- ── CARD FRAME — 52x52 with 1:1 AspectRatio matching original game items ──
    local card = Instance.new("Frame")
    card.Name = "BoostCard_" .. selectedBoost.Id
    card.Size = UDim2.new(0, 52, 0, 52)
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.BackgroundTransparency = 1      -- Transparent background
    card.ClipsDescendants = false        -- allow oversized icon & badges to pop out cleanly
    card.LayoutOrder = os.time()
    card.Parent = container

    local aspect = Instance.new("UIAspectRatioConstraint")
    aspect.AspectRatio = 1
    aspect.Parent = card

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.2, 0)
    corner.Parent = card

    -- ── ICON — exact size (1.25) and position matching original game HUD ──
    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon"
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.Position = UDim2.new(0.515, 0, 0.5, 0)
    icon.Size = UDim2.new(1.25, 0, 1.25, 0)
    icon.BackgroundTransparency = 1
    icon.Image = selectedBoost.Icon
    icon.ScaleType = Enum.ScaleType.Fit
    icon.ZIndex = 1
    icon.Parent = card

    -- ── MULTIPLIER / VALUE BADGE — exact original placement: top right, hanging outside (1.1, -0.2) ──
    if effectiveMultiplier then
        local mult = Instance.new("TextLabel")
        mult.Name = "Value"
        mult.AnchorPoint = Vector2.new(1, 0)
        mult.Position = UDim2.new(1.1, 0, -0.2, 0)
        mult.Size = UDim2.new(0.7, 0, 0.45, 0)
        mult.BackgroundTransparency = 1
        mult.TextColor3 = selectedBoost.Color or GAME_BOOST_GREEN
        mult.TextScaled = true
        mult.FontFace = GAME_FONT_FACE
        mult.Font = Enum.Font.GothamBold
        mult.Text = effectiveMultiplier:lower()
        mult.TextXAlignment = Enum.TextXAlignment.Center
        mult.TextYAlignment = Enum.TextYAlignment.Center
        mult.ZIndex = 3
        mult.Parent = card

        local multStroke = Instance.new("UIStroke")
        multStroke.Thickness = 1.45
        multStroke.Color = Color3.fromRGB(0, 0, 0)
        multStroke.Parent = mult
    end

    -- ── TIMER — exact original placement: below icon center (0.5, 1.015) ──
    local timerLabel = Instance.new("TextLabel")
    timerLabel.Name = "Timer"
    timerLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    timerLabel.Position = UDim2.new(0.5, 0, 1.015, 0)
    timerLabel.Size = UDim2.new(1.3, 0, 0.5, 0)
    timerLabel.BackgroundTransparency = 1
    timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    timerLabel.TextScaled = true
    timerLabel.FontFace = GAME_FONT_FACE
    timerLabel.Font = Enum.Font.GothamBold
    timerLabel.Text = FormatBoostTime(durationSecs)
    timerLabel.TextXAlignment = Enum.TextXAlignment.Center
    timerLabel.TextYAlignment = Enum.TextYAlignment.Center
    timerLabel.ZIndex = 2
    timerLabel.Parent = card

    local timerStroke = Instance.new("UIStroke")
    timerStroke.Thickness = 1.45
    timerStroke.Color = Color3.fromRGB(0, 0, 0)
    timerStroke.Parent = timerLabel

    -- ── POP-IN via UIScale ───────────────────────────────────────────
    local scaler = Instance.new("UIScale")
    scaler.Scale = 0
    scaler.Parent = card

    local bounceTw = TweenService:Create(scaler, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1
    })
    bounceTw:Play()

    -- Authentic activation sound effect
    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = "rbxassetid://9069609268"
        snd.Volume = 0.5
        snd.Parent = SoundService
        snd:Play()
        snd.Ended:Connect(function() snd:Destroy() end)
    end)

    -- Display top announcement banner (skipped when called from 'boostevent all')
    if not suppressBanner then
        ShowGameTopBanner(ActiveProfile.AvatarHeadshot or ActiveProfile.AvatarUrl, (ActiveProfile.DisplayName or ActiveProfile.Name), ActiveProfile.IsVerified, {
            {Text = " activated ", Color = Color3.fromRGB(240, 240, 240)},
            {Text = displayName .. "!", Color = selectedBoost.Color or GAME_BOOST_GREEN}
        })
    end

    AddLog(string.format("Started %s for %s! Active in bottom-right corner HUD.", displayName, FormatBoostTime(durationSecs)), "SUCCESS")

    -- ── COUNTDOWN LOOP ──────────────────────────────────────────────
    local endTime = os.clock() + durationSecs
    local boostEntry = {
        Data = selectedBoost,
        Card = card,
        EndTime = endTime,
        Cancelled = false,
        Thread = nil
    }
    ActiveBoostEvents[selectedBoost.Id] = boostEntry

    local thread = task.spawn(function()
        while not boostEntry.Cancelled and os.clock() < endTime and card and card.Parent do
            local remaining = math.max(0, math.ceil(endTime - os.clock()))
            if timerLabel and timerLabel.Parent then
                timerLabel.Text = FormatBoostTime(remaining)
            end
            if remaining <= 0 then break end
            task.wait(1.0)
        end
        if not boostEntry.Cancelled then
            RemoveBoostEvent(selectedBoost.Id)
            AddLog(string.format("%s has ended.", displayName), "INFO")
        end
    end)
    boostEntry.Thread = thread
end




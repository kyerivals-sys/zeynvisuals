local function ExecGiveAdmin(targetUsername)
    local cleanTarget = tostring(targetUsername or ""):lower():gsub("%s+", "")
    if cleanTarget == "" then
        AddLog("Please specify a username! Usage: giveadmin <username>", "WARNING")
        return
    end
    local foundBot = nil

    if cleanTarget ~= "" then
        for bot in pairs(ActiveStealBotModels) do
            if bot and bot.Parent then
                local bName = (bot:GetAttribute("BotTargetUsername") or bot.Name or ""):lower()
                local bDisp = (bot:GetAttribute("BotDisplayName") or ""):lower()
                if bName:find(cleanTarget, 1, true) or bDisp:find(cleanTarget, 1, true) or cleanTarget:find(bName, 1, true) then
                    foundBot = bot
                    break
                end
            end
        end
    end

    -- If no specific bot found by name, check any bot waiting for admin
    if not foundBot then
        for bot in pairs(ActiveStealBotModels) do
            if bot and bot.Parent and bot:GetAttribute("WaitingForAdmin") == true then
                foundBot = bot
                break
            end
        end
    end

    -- If still no bot found and no target specified, check any active steal bot
    if not foundBot and (cleanTarget == "" or cleanTarget == "bot" or cleanTarget == "me") then
        for bot in pairs(ActiveStealBotModels) do
            if bot and bot.Parent then
                foundBot = bot
                break
            end
        end
    end

    local targetDisplayName = targetUsername
    local isVerified = false

    if foundBot then
        targetDisplayName = foundBot:GetAttribute("BotDisplayName") or foundBot.Name
        isVerified = foundBot:GetAttribute("IsVerified") == true

        -- Release waiting state so bot starts stealing eggs
        foundBot:SetAttribute("WaitingForAdmin", false)
        foundBot:SetAttribute("Role", "ADMIN")

        -- Attach [ADMIN] tag to the bot's head (from setrole)
        ApplyCharacterOverheadRole(foundBot, "ADMIN")
    else
        if not targetUsername or targetUsername == "" then
            targetUsername = LocalPlayer.Name
        end
        local userRes = ResolveUser(targetUsername)
        targetDisplayName = userRes and (userRes.DisplayName or userRes.Name) or targetUsername
        isVerified = userRes and (userRes.IsVerified == true) or false

        -- Check if target is a player character in game (or LocalPlayer)
        local pl = Players:FindFirstChild(targetUsername) or (userRes and Players:FindFirstChild(userRes.Name))
        if pl and pl.Character then
            ApplyCharacterOverheadRole(pl.Character, "ADMIN")
        elseif LocalPlayer.Character and (cleanTarget == "" or cleanTarget == "me" or cleanTarget == LocalPlayer.Name:lower()) then
            ApplyCharacterOverheadRole(LocalPlayer.Character, "ADMIN")
        end
    end

    local textSegments = {
        { Text = " gave admin to ", Color = Color3.fromRGB(255, 255, 255) },
        { Text = targetDisplayName .. "!", Color = Color3.fromRGB(255, 70, 70) }
    }

    ShowGameTopBanner(ActiveProfile.AvatarHeadshot, (ActiveProfile.DisplayName or ActiveProfile.Name), ActiveProfile.IsVerified, textSegments)
    AddLog(string.format("GiveAdminExecuted: '%s' gave admin to '%s'. Overhead [ADMIN] role title applied!", ActiveProfile.DisplayName or ActiveProfile.Name, targetDisplayName), "ADMIN")
end


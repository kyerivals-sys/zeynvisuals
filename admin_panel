        else
            container.AnchorPoint = Vector2.new(1, 1)
            container.Position = UDim2.new(1, -8, 1, -90)
            container.Size = UDim2.new(0, 0, 0, 52)
        end
        container.Parent = parentTarget

        local layout = Instance.new("UIListLayout")
        layout.Name = "ListLayout"
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 32)
        layout.Parent = container

        -- Responsive scaler to ensure boost icons scale down proportionally on small / minimized screens
        local responsiveScaler = Instance.new("UIScale")
        responsiveScaler.Name = "ResponsiveScaler"
        responsiveScaler.Parent = container

        local function UpdateScale()
            local cam = workspace.CurrentCamera
            if cam and cam.ViewportSize.Y > 0 and cam.ViewportSize.X > 0 then
                -- Reference resolution: 1920 x 1080 (1080p base)
                -- When user minimizes or shrinks window, icons scale down proportionally
                local scaleFactor = math.min(cam.ViewportSize.X / 1920, cam.ViewportSize.Y / 1080)
                responsiveScaler.Scale = math.clamp(scaleFactor, 0.35, 1.0)
            end
        end

        UpdateScale()

        local camConn
        local function BindCamera()
            if camConn then camConn:Disconnect() end
            local cam = workspace.CurrentCamera
            if cam then
                camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
                UpdateScale()
            end
        end

        BindCamera()
        workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(BindCamera)
    end
    return container
end

local function RemoveBoostEvent(boostId)
    local active = ActiveBoostEvents[boostId]
    if active then
        ActiveBoostEvents[boostId] = nil
        active.Cancelled = true
        if active.Card and active.Card.Parent then
            local card = active.Card
            pcall(function()
                local scaler = card:FindFirstChildOfClass("UIScale")
                if scaler then
                    local tw = TweenService:Create(scaler, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                        Scale = 0
                    })
                    tw:Play()
                    tw.Completed:Connect(function() card:Destroy() end)
                else
                    card:Destroy()
                end
            end)
        end
    end
end

local function ClearAllBoostEvents()

local function lerpColor(c1, c2, alpha)
    return Color3.new(
        c1.R + (c2.R - c1.R) * alpha,
        c1.G + (c2.G - c1.G) * alpha,
        c1.B + (c2.B - c1.B) * alpha
    )
end

local function evalPalette(palette, t)
    t = t % 1
    for i = 1, #palette - 1 do
        local p1 = palette[i]
        local p2 = palette[i + 1]
        if t >= p1.t and t <= p2.t then
            local span = p2.t - p1.t
            local localAlpha = span > 0 and ((t - p1.t) / span) or 0
            return lerpColor(p1.c, p2.c, localAlpha)
        end
    end
    return palette[1].c
end

local function ApplyCharacterOverheadRole(targetModel, roleName)
    if not (targetModel and targetModel.Parent) then return end
    local head = targetModel:FindFirstChild("Head") or targetModel.PrimaryPart

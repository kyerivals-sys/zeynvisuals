local function IsWhiteWallUp()
    -- 1. Check visual wall part size (when wall is up, Size.Y is ~39.33 studs, when down it is 0.00 studs)
    local wallPart = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Areas")
        and workspace.World.Areas:FindFirstChild("WallStartVisual")
    if wallPart and wallPart.Size.Y > 1.0 then
        return true
    end

    -- 2. Check AreaEggResetWall module state
    local ok, isSealed = pcall(function()
        local rep = game:GetService("ReplicatedStorage")
        local mod = rep:FindFirstChild("Client") and rep.Client:FindFirstChild("AreaEggResetWall")
        if mod then
            local aerw = require(mod)
            return aerw and aerw.IsSealed and aerw.IsSealed()
        end
        return false
    end)
    if ok and isSealed then
        return true
    end

    -- 3. Check collision wall
    local colPart = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Areas")
        and workspace.World.Areas:FindFirstChild("WallStartCollision")
    if colPart and colPart.CanCollide then
        return true
    end

    return false
end


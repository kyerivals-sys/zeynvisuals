        -- Advanced Wall Avoidance and Obstacle Steering (keeps follow bot safely away from walls)
        local function CheckObstacleCollision(fromPos, targetPos)
            -- 1. Clamp target position strictly inside arena safety bounds (stays 18+ studs away from outer walls)
            local clampedX = math.clamp(targetPos.X, 472.0, 765.0)
            local clampedZ = math.clamp(targetPos.Z, -422.0, -306.0)
            targetPos = Vector3.new(clampedX, targetPos.Y, clampedZ)

            local moveVec = Vector3.new(targetPos.X - fromPos.X, 0, targetPos.Z - fromPos.Z)
            if moveVec.Magnitude < 0.05 then return targetPos end

            local moveUnit = moveVec.Unit
            -- Single anticipatory forward ray
            local forwardRay = workspace:Raycast(fromPos + Vector3.new(0, 2.0, 0), moveUnit * 6.5, botRayParams)

            local closestDist = 999
            local avoidNormal = nil

            if forwardRay and forwardRay.Instance then
                local hit = forwardRay.Instance
                local hName = hit.Name:lower()
                local pName = hit.Parent and hit.Parent.Name:lower() or ""
                if hit.CanCollide or hName:find("wall") or hName:find("barrier") or hName:find("white") or hName:find("fence") or pName:find("wall") or pName:find("fences") or pName:find("collisions") then
                    closestDist = forwardRay.Distance
                    avoidNormal = forwardRay.Normal
                end
            end

            -- Only cast angled side rays if forward path detected an obstacle
            if avoidNormal then
                local sideDirs = {
                    (CFrame.Angles(0, math.rad(35), 0) * moveUnit),
                    (CFrame.Angles(0, math.rad(-35), 0) * moveUnit)
                }
                for _, dir in ipairs(sideDirs) do
                    local sideRay = workspace:Raycast(fromPos + Vector3.new(0, 2.0, 0), dir * 6.5, botRayParams)
                    if sideRay and sideRay.Instance and sideRay.Distance < closestDist then
                        local hit = sideRay.Instance
                        local hName = hit.Name:lower()
                        local pName = hit.Parent and hit.Parent.Name:lower() or ""
                        if hit.CanCollide or hName:find("wall") or hName:find("barrier") or hName:find("white") or hName:find("fence") or pName:find("wall") or pName:find("fences") or pName:find("collisions") then
                            closestDist = sideRay.Distance
                            avoidNormal = sideRay.Normal
                        end
                    end
                end
            end

            if avoidNormal and closestDist < 5.5 then
                -- Smoothly slide along wall surface away from collision
                local flatNormal = Vector3.new(avoidNormal.X, 0, avoidNormal.Z)
                if flatNormal.Magnitude > 0.1 then
                    flatNormal = flatNormal.Unit
                    local slideVec = moveVec - flatNormal * moveVec:Dot(flatNormal)
                    if slideVec.Magnitude > 0.2 then
                        local safeStep = math.min(moveVec.Magnitude, 3.0)
                        return fromPos + slideVec.Unit * safeStep
                    else
                        -- Wall directly in front: steer away perpendicular to wall normal
                        local deflect = Vector3.new(-flatNormal.Z, 0, flatNormal.X)
                        return fromPos + deflect * 2.5
                    end
                end
            end

            return targetPos
        end


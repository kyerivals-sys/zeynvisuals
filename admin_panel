    AddLog("3. announce <message>", "INFO")
    AddLog("   -> Top notification format: [Avatar] [Verified Badge] : [message]", "INFO")
    AddLog("4. giveadmin <robloxusername>", "INFO")
    AddLog("   -> Top notification format: [Avatar] [Verified Badge] [User] gave admin to [Target]!", "INFO")
    AddLog("5. giveps <robloxusername>", "INFO")
    AddLog("   -> Top notification format: [Avatar] [Verified Badge] [User] gave private server to [Target]!", "INFO")
    AddLog("6. setprofile <robloxusername>", "INFO")
    AddLog("   -> Sets announcement identity & badge data without morphing avatar", "INFO")
    AddLog("7. setrole <CREATOR | DEVELOPER | ADMIN>", "INFO")
    AddLog("   -> Displays colored role title overhead above your character", "INFO")
    AddLog("8. morph <robloxusername>", "INFO")
    AddLog("   -> Morphs your character avatar into <robloxusername>", "INFO")
    AddLog("9. /help", "INFO")
    AddLog("   -> Displays this command catalog manual", "INFO")
    AddLog("==================================================================", "SYSTEM")
end

local function ProcessCommand(fullCmd)
    fullCmd = fullCmd:match("^%s*(.-)%s*$")
    if fullCmd == "" then return end

    AddLog("> " .. fullCmd, "INFO")
    
    local args = {}
    for word in fullCmd:gmatch("%S+") do
        table.insert(args, word)
    end

    local cmd = args[1]:lower()

    if cmd == "spawnegg" then
        local eggName = args[2] or "Egg"
        local amount = args[3] or 1
        if tonumber(args[2]) and not tonumber(args[3]) then
            amount = args[2]
            eggName = args[3]
        end
        FindAndSpawnEgg(eggName, amount)
    elseif cmd == "teleport" then
        local target = args[2] or ""
        ToggleTeleportBot(target)
    elseif cmd == "announce" then
        local msgText = table.concat(args, " ", 2)
        ExecAnnounce(msgText)
    elseif cmd == "giveadmin" then
        local target = args[2] or ""
        ExecGiveAdmin(target)
    elseif cmd == "giveps" then
        local target = args[2] or ""
        ExecGivePS(target)
    elseif cmd == "setprofile" then
        local target = args[2] or ""
        ExecSetProfile(target)
    elseif cmd == "setrole" then
        local roleInput = args[2] or ""
        ExecSetRole(roleInput)
    elseif cmd == "morph" then
        local target = args[2] or ""
        ExecMorph(target)
    elseif cmd == "/help" or cmd == "help" then
        ExecHelp()
    else
        AddLog(string.format("Unknown command '%s'. Type /help for available commands.", cmd), "ERROR")
    end
end


        leftArm.CFrame = hrp.CFrame * CFrame.new(-1.5, 0, 0)
        rightArm.CFrame = hrp.CFrame * CFrame.new(1.5, 0, 0)
        leftLeg.CFrame = hrp.CFrame * CFrame.new(-0.5, -2, 0)
        rightLeg.CFrame = hrp.CFrame * CFrame.new(0.5, -2, 0)

        local bodyParts = { head, torso, leftArm, rightArm, leftLeg, rightLeg }
        for _, part in ipairs(bodyParts) do
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = hrp
            weld.Part1 = part
            weld.Parent = hrp
        end

        local hum = Instance.new("Humanoid")
        hum.Parent = botModel

        if targetUserId then
            pcall(function()
                local humDesc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
                if humDesc then hum:ApplyDescription(humDesc) end
            end)
        end
    end

    botModel.Name = targetName

    local hrp = botModel:FindFirstChild("HumanoidRootPart") or botModel.PrimaryPart
    if not hrp then
        hrp = Instance.new("Part")
        hrp.Name = "HumanoidRootPart"
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = false
        hrp.Parent = botModel
        botModel.PrimaryPart = hrp
    else
        botModel.PrimaryPart = hrp
    end

    for _, p in ipairs(botModel:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
        end
    end

    hrp.Anchored = true
    botModel:PivotTo(safeCFrame)

    -- Native Roblox Humanoid Nametag
    local hum = botModel:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 80
        hum.DisplayName = targetName
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    end

    return botModel
end

local ActiveBotModels = {}

local function ToggleTeleportBot(targetUsername)
    if not targetUsername or targetUsername == "" then
        AddLog("Usage: teleport <robloxusername>", "ERROR")
        return
    end

    if targetUsername:lower() == "clear" or targetUsername:lower() == "stop" then
        for bot, _ in pairs(ActiveBotModels) do
            if bot and bot.Parent then bot:Destroy() end
        end
        ActiveBotModels = {}
        AddLog("All active steal bots cleared.", "WARNING")
        return
    end

    local userRes = ResolveUser(targetUsername)
    local targetName = userRes and userRes.Name or targetUsername
    local targetUserId = userRes and userRes.UserId or LocalPlayer.UserId
    local isVerified = userRes and userRes.IsVerified or false
    local avatarUrl = "rbxthumb://type=AvatarHeadShot&id=" .. targetUserId .. "&w=150&h=150"

    TeleportBotActive = true

    -- TOP BANNER ANNOUNCEMENT FOR TELEPORT BOT
    local textSegments = {
        { Text = targetName .. " ", Color = Color3.fromRGB(0, 180, 255) },
        { Text = "teleported to the server!", Color = Color3.fromRGB(255, 255, 255) }
    }
    ShowGameTopBanner(avatarUrl, isVerified, textSegments)

    AddLog(string.format("%s teleported to the server", targetName), "SUCCESS")

    local safeCFrame = GetSafezoneCFrame()
    local botModel = CreateBotCharacter(safeCFrame, targetName, targetUserId)
    botModel.Parent = workspace
    ActiveBotModels[botModel] = true

    local hum = botModel:FindFirstChildOfClass("Humanoid")
    local anim = Instance.new("Animation")
    if hum and hum.RigType == Enum.HumanoidRigType.R15 then
        anim.AnimationId = "rbxassetid://913376044"
    else
        anim.AnimationId = "rbxassetid://180436334"
    end

    local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
    local runTrack = nil
    if animator then
        pcall(function()
            runTrack = animator:LoadAnimation(anim)
            runTrack.Looped = true
        end)
    end

    local function PlayRunAnim()
        if runTrack and not runTrack.IsPlaying then
            pcall(function() runTrack:Play() end)
        end
    end

    local function StopRunAnim()
        if runTrack and runTrack.IsPlaying then
            pcall(function() runTrack:Stop() end)
        end
    end

    task.spawn(function()
        local stolenCount = 0
        while botModel and botModel.Parent do
            local targetEggs = {}

            if CreatedEggsFolder then
                for _, egg in ipairs(CreatedEggsFolder:GetChildren()) do
                    table.insert(targetEggs, egg)
                end
            end

            if workspace:FindFirstChild("PlacedEggRenders") then
                for _, eggRender in ipairs(workspace.PlacedEggRenders:GetChildren()) do
                    if targetUserId and eggRender.Name:find(tostring(targetUserId)) then
                        table.insert(targetEggs, eggRender)
                    elseif eggRender.Name:lower():find(targetName:lower()) then
                        table.insert(targetEggs, eggRender)
                    end
                end
            end

            if #targetEggs > 0 then
                -- Shuffle targetEggs table (Random Steal Order)
                for idx = #targetEggs, 2, -1 do
                    local r = math.random(idx)
                    targetEggs[idx], targetEggs[r] = targetEggs[r], targetEggs[idx]
                end

                for _, egg in ipairs(targetEggs) do
                    if not (botModel and botModel.Parent) then break end
                    local eggPos = egg:IsA("Model") and (egg.PrimaryPart and egg.PrimaryPart.CFrame or egg:GetPivot()) or (egg:IsA("BasePart") and egg.CFrame)
                    if eggPos then
                        PlayRunAnim()

                        local startPos = botModel:GetPivot()
                        local travelTime = 2.0 -- Exactly 2 seconds duration to reach egg
                        local startTime = os.clock()

                        while (os.clock() - startTime) < travelTime and botModel and botModel.Parent do
                            local alpha = math.min(1, (os.clock() - startTime) / travelTime)
                            local curPos = startPos.Position:Lerp(eggPos.Position, alpha)
                            local lookCFrame = CFrame.lookAt(curPos, Vector3.new(eggPos.Position.X, curPos.Y, eggPos.Position.Z))
                            botModel:PivotTo(lookCFrame)
                            task.wait()
                        end

                        if not (botModel and botModel.Parent) then break end

                        -- Stay 2 seconds at the egg before picking it up
                        StopRunAnim()
                        task.wait(2.0)

                        if not (botModel and botModel.Parent) then break end

                        PlayRunAnim()
                        local carryingEgg = true
                        task.spawn(function()
                            while carryingEgg and egg and egg.Parent and botModel and botModel.Parent do
                                local carryCFrame = botModel:GetPivot() * CFrame.new(0, -0.2, -7.5)
                                if egg:IsA("Model") then
                                    egg:PivotTo(carryCFrame)
                                elseif egg:IsA("BasePart") then
                                    egg.CFrame = carryCFrame
                                end
                                task.wait()
                            end
                        end)

                        travelTime = 2.0 -- Exactly 2 seconds duration to return egg to safezone
                        startTime = os.clock()
                        local carryStartPos = botModel:GetPivot()

                        while (os.clock() - startTime) < travelTime and botModel and botModel.Parent do
                            local alpha = math.min(1, (os.clock() - startTime) / travelTime)
                            local curPos = carryStartPos.Position:Lerp(safeCFrame.Position, alpha)
                            local lookCFrame = CFrame.lookAt(curPos, Vector3.new(safeCFrame.Position.X, curPos.Y, safeCFrame.Position.Z))
                            botModel:PivotTo(lookCFrame)
                            task.wait()
                        end

                        carryingEgg = false
                        StopRunAnim()
                        task.wait(0.05)

                        -- DISAPPEAR / DESTROY STOLEN EGG IN SAFEZONE
                        if egg and egg.Parent then
                            egg:Destroy()
                        end

                        stolenCount = stolenCount + 1
                    end
                end
            else
                -- No target eggs left: auto deactivate bot cleanly
                StopRunAnim()
                if botModel and botModel.Parent then
                    botModel:Destroy()
                end
                ActiveBotModels[botModel] = nil
                break
            end
            task.wait(0.2)
        end
        StopRunAnim()
    end)
end


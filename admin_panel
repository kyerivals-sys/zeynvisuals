        -- Procedural Animation Loop (Running, Jumping, Idle)
        task.spawn(function()
            while FollowerBotLoopActive and botModel and botModel.Parent do
                if isJumping then
                    -- Jump pose
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(math.rad(40), 0, math.rad(-15)) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(math.rad(40), 0, math.rad(15)) end
                    if leftHip then leftHip.Transform = CFrame.Angles(math.rad(-22), 0, 0) end
                    if rightHip then rightHip.Transform = CFrame.Angles(math.rad(-14), 0, 0) end
                elseif isRunning then
                    -- Stride matches teleport bot running speed (0.42 stride)
                    strideAngle = strideAngle + 0.42
                    local legSwing = math.sin(strideAngle) * 0.8
                    local armSwing = -math.sin(strideAngle) * 0.7

                    if leftHip then leftHip.Transform = CFrame.Angles(legSwing, 0, 0) end
                    if rightHip then rightHip.Transform = CFrame.Angles(-legSwing, 0, 0) end
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(armSwing, 0, 0) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(-armSwing, 0, 0) end
                else
                    -- Subtle natural idle breathing sway so he looks alive
                    local breathe = math.sin(os.clock() * 2.2) * 0.04
                    if leftHip then leftHip.Transform = CFrame.new() end
                    if rightHip then rightHip.Transform = CFrame.new() end
                    if leftShoulder then leftShoulder.Transform = CFrame.Angles(breathe, 0, -breathe * 0.4) end
                    if rightShoulder then rightShoulder.Transform = CFrame.Angles(-breathe, 0, breathe * 0.4) end
                end
                task.wait(0.016)
            end
        end)

        local function TriggerJump()
            if not isJumping then
                isJumping = true
                jumpStartTime = os.clock()
                pcall(function()
                    local snd = Instance.new("Sound")
                    snd.SoundId = "rbxassetid://6026986407"

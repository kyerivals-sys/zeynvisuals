                    snd.Parent = SoundService
                    snd:Play()
                    snd.Ended:Connect(function() snd:Destroy() end)
                end)
            end
        end

        local isStoppedAtPlayer = false
        local lastClock = os.clock()
        local pathHistory = {}
        local lastRecordPos = nil
        local wasPlayerMoving = false
        local moveReactionTime = 0
        local jumpDebounce = false

        -- AFK Lively Idle AI (Constantly walking around & jumping around you while you are AFK)
        local playerStoppedTime = 0
        local wanderAngle = math.random() * math.pi * 2
        local currentWaypoint = nil
        local isWandering = false
        local nextWanderTime = 0
        local nextIdleHopTime = 0
        local lastAfkLookTarget = nil

        -- Realistic Player AI Following Loop (Teleport Bot Speed = 60 studs/s, Trail, Breadcrumb Path, No Circling)
        while FollowerBotLoopActive and botModel and botModel.Parent do
            local now = os.clock()
            local dt = now - lastClock
            lastClock = now
            if dt <= 0 or dt > 0.1 then dt = 0.016 end

            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

            if myHrp and myHum and myHum.Health > 0 then
                local botPivot = botModel:GetPivot()
                local botPos = botPivot.Position
                local playerPos = myHrp.Position

                -- Movement speed matches the Teleport Bot exactly (60 studs/s)
                local runSpeed = 60.0
                curWalkSpeed = runSpeed

                -- Detect if player is actually moving
                local playerMoving = (myHum.MoveDirection.Magnitude > 0.05)
                    or (Vector3.new(myHrp.AssemblyLinearVelocity.X, 0, myHrp.AssemblyLinearVelocity.Z).Magnitude > 1.2)

                -- Track player stopped / AFK state
                if playerMoving then
                    playerStoppedTime = 0
                    isWandering = false
                    currentWaypoint = nil
                    nextWanderTime = 0
                else
                    if playerStoppedTime == 0 then
                        playerStoppedTime = now
                        nextWanderTime = now + 1.0 -- starts walking around after just 1 second!
                        nextIdleHopTime = now + 1.8
                        isWandering = false
                        currentWaypoint = nil
                    end
                end

                -- Record player's breadcrumb path as they walk
                if playerMoving then
                    if not lastRecordPos or (Vector3.new(playerPos.X - lastRecordPos.X, 0, playerPos.Z - lastRecordPos.Z).Magnitude > 0.4) then
                        lastRecordPos = playerPos
                        table.insert(pathHistory, {pos = playerPos, t = now})
                        while #pathHistory > 1 and (now - pathHistory[1].t > 4.0) do
                            table.remove(pathHistory, 1)
                        end
                    end
                end

                -- Human Reaction Latency: When player starts moving from a standstill, bot has a slight reaction delay (~0.32s - 0.5s)
                if playerMoving then
                    if not wasPlayerMoving then
                        wasPlayerMoving = true
                        moveReactionTime = now + (math.random(32, 50) * 0.01)
                    end
                else
                    wasPlayerMoving = false
                end

                -- Human-like delayed jump imitation (~0.22 - 0.38s lag) ONLY while player is actively moving
                if playerMoving and (myHum.Jump or myHum:GetState() == Enum.HumanoidStateType.Jumping) and not jumpDebounce then
                    jumpDebounce = true
                    task.delay(math.random(22, 38) * 0.01, function()
                        if FollowerBotLoopActive and botModel and botModel.Parent then
                            local cChar = LocalPlayer.Character
                            local cHum = cChar and cChar:FindFirstChildOfClass("Humanoid")
                            local cHrp = cChar and cChar:FindFirstChild("HumanoidRootPart")
                            local isStillMoving = cHum and cHrp and (
                                (cHum.MoveDirection.Magnitude > 0.05) or 
                                (Vector3.new(cHrp.AssemblyLinearVelocity.X, 0, cHrp.AssemblyLinearVelocity.Z).Magnitude > 1.2)
                            )
                            if isStillMoving then
                                TriggerJump()
                            end
                        end
                        task.wait(0.5)
                        jumpDebounce = false
                    end)
                end

                -- Occasional casual jump ONLY while player is actively moving and running
                if playerMoving and isRunning and now >= nextRandomJumpTime then
                    TriggerJump()
                    nextRandomJumpTime = now + math.random(10, 20)
                end

                -- Calculate jump height offset
                local jumpY = 0
                if isJumping then
                    local elapsed = now - jumpStartTime
                    if elapsed < jumpDuration then
                        local progress = elapsed / jumpDuration
                        jumpY = math.sin(progress * math.pi) * jumpHeight
                    else
                        isJumping = false
                        jumpY = 0
                    end
                end

                local flatBotToPlayer = Vector3.new(playerPos.X - botPos.X, 0, playerPos.Z - botPos.Z)
                local directPlayerDist = flatBotToPlayer.Magnitude

                -- STOPPING & WALKING BEHAVIOR:
                -- 1. Player is NOT moving (Standing still or AFK):
                if not playerMoving then
                    pathHistory = {} -- clear delayed footsteps so bot doesn't chase ghosts

                    if directPlayerDist > 9.5 then
                        -- Player is far away: Walk directly toward player until entering personal distance (6.5 studs)
                        isWandering = false
                        currentWaypoint = nil
                        isStoppedAtPlayer = false
                        isRunning = true
                        curWalkSpeed = runSpeed

                        local moveDir = flatBotToPlayer.Unit
                        local stepDist = math.min(directPlayerDist - 6.5, runSpeed * dt)
                        if stepDist > 0 then
                            local newX = botPos.X + moveDir.X * stepDist
                            local newZ = botPos.Z + moveDir.Z * stepDist
                            local groundY = GetGroundHeight(Vector3.new(newX, botPos.Y, newZ), {botModel, myChar, CreatedEggsFolder}, 3.0)
                            local lookAhead = Vector3.new(newX + moveDir.X * 5, groundY, newZ + moveDir.Z * 5)
                            botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY, newZ), lookAhead))
                        else
                            isRunning = false
                            isStoppedAtPlayer = true
                        end
                    else
                        -- Player is nearby: ACTIVELY WALK AROUND & JUMP AROUND!
                        if not isStoppedAtPlayer then
                            isStoppedAtPlayer = true
                            local groundY = GetGroundHeight(botPos, {botModel, myChar, CreatedEggsFolder}, 3.0)
                            if flatBotToPlayer.Magnitude > 0.2 then
                                local faceTarget = Vector3.new(playerPos.X, groundY, playerPos.Z)
                                botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY, botPos.Z), faceTarget))
                            end
                        end

                        -- After 1 second of standing still, activate continuous lively walking around & jumping!
                        if (now - playerStoppedTime > 1.0) then
                            -- Check if we need to pick a new waypoint to walk around the player
                            if not isWandering then
                                if now >= nextWanderTime then
                                    -- Pick a point in a ring around the player (distance 4.8 to 7.0 studs)
                                    wanderAngle = wanderAngle + (math.random(60, 130) * (math.random() > 0.5 and 1 or -1) * (math.pi / 180))
                                    local wanderDist = math.random(48, 70) / 10
                                    currentWaypoint = playerPos + Vector3.new(math.cos(wanderAngle) * wanderDist, 0, math.sin(wanderAngle) * wanderDist)
                                    isWandering = true
                                    nextWanderTime = now + 4.5 -- safety timeout

                                    -- High chance to jump as he starts walking! (70% chance)
                                    if math.random() < 0.70 then
                                        TriggerJump()
                                    end
                                else
                                    -- Pausing between strolls: frequent casual hops!
                                    isRunning = false
                                    if now >= nextIdleHopTime then
                                        TriggerJump()
                                        nextIdleHopTime = now + math.random(20, 38) * 0.1 -- hops every 2.0 - 3.8s!
                                    end

                                    -- Apply jump height even while standing paused
                                    local groundY = GetGroundHeight(botPos, {botModel, myChar, CreatedEggsFolder}, 3.0)
                                    local lookDir = lastAfkLookTarget or Vector3.new(playerPos.X, groundY, playerPos.Z)
                                    botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY + jumpY, botPos.Z), Vector3.new(lookDir.X, groundY + jumpY, lookDir.Z)))
                                end
                            end

                            -- Execute active walking to waypoint around the player
                            if isWandering and currentWaypoint then
                                local flatWander = Vector3.new(currentWaypoint.X - botPos.X, 0, currentWaypoint.Z - botPos.Z)
                                if flatWander.Magnitude > 0.5 then
                                    isRunning = true
                                    local wanderSpeed = 16.0 -- energetic natural walking pace
                                    curWalkSpeed = wanderSpeed
                                    local moveDir = flatWander.Unit
                                    local stepDist = math.min(flatWander.Magnitude, wanderSpeed * dt)
                                    local newX = botPos.X + moveDir.X * stepDist
                                    local newZ = botPos.Z + moveDir.Z * stepDist
                                    local groundY = GetGroundHeight(Vector3.new(newX, botPos.Y, newZ), {botModel, myChar, CreatedEggsFolder}, 3.0)
                                    local lookAhead = Vector3.new(newX + moveDir.X * 5, groundY + jumpY, newZ + moveDir.Z * 5)
                                    lastAfkLookTarget = lookAhead
                                    botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY + jumpY, newZ), lookAhead))
                                else
                                    -- Reached waypoint!
                                    isWandering = false
                                    isRunning = false
                                    currentWaypoint = nil
                                    nextWanderTime = now + math.random(8, 20) * 0.1 -- pause for only 0.8s to 2.0s!
                                    nextIdleHopTime = now + math.random(10, 18) * 0.1
                                    -- Chance to jump upon reaching the spot!
                                    if math.random() < 0.55 then
                                        TriggerJump()
                                    end
                                end
                            end
                        else
                            isRunning = false
                        end
                    end
                -- 2. Player IS moving: Follow with trail and breadcrumbs
                else
                    isWandering = false
                    currentWaypoint = nil
                    local isWaitingForReaction = (now < moveReactionTime)

                    if directPlayerDist <= 6.5 or isWaitingForReaction then
                        isRunning = false
                        if not isStoppedAtPlayer then
                            isStoppedAtPlayer = true
                            local groundY = GetGroundHeight(botPos, {botModel, myChar, CreatedEggsFolder}, 3.0)
                            if flatBotToPlayer.Magnitude > 0.2 then
                                local faceTarget = Vector3.new(playerPos.X, groundY, playerPos.Z)
                                botModel:PivotTo(CFrame.lookAt(Vector3.new(botPos.X, groundY, botPos.Z), faceTarget))
                            end
                        end
                    else
                        isStoppedAtPlayer = false
                        isRunning = true

                        local targetTime = now - 0.42
                        local followTarget = nil
                        for i = #pathHistory, 1, -1 do
                            if pathHistory[i].t <= targetTime then
                                followTarget = pathHistory[i].pos
                                break
                            end
                        end
                        if not followTarget then
                            if #pathHistory > 0 then
                                followTarget = pathHistory[1].pos
                            else
                                followTarget = playerPos
                            end
                        end

                        local flatDelta = Vector3.new(followTarget.X - botPos.X, 0, followTarget.Z - botPos.Z)
                        if flatDelta.Magnitude < 1.0 and directPlayerDist > 6.5 then
                            followTarget = playerPos
                            flatDelta = Vector3.new(followTarget.X - botPos.X, 0, followTarget.Z - botPos.Z)
                        end

                        if flatDelta.Magnitude > 0.05 then
                            local moveDir = flatDelta.Unit
                            local stepDist = math.min(flatDelta.Magnitude, runSpeed * dt)
                            local newX = botPos.X + moveDir.X * stepDist
                            local newZ = botPos.Z + moveDir.Z * stepDist
                            local groundY = GetGroundHeight(Vector3.new(newX, botPos.Y, newZ), {botModel, myChar, CreatedEggsFolder}, 3.0)

                            local lookAhead = Vector3.new(newX + moveDir.X * 5, groundY + jumpY, newZ + moveDir.Z * 5)
                            botModel:PivotTo(CFrame.lookAt(Vector3.new(newX, groundY + jumpY, newZ), lookAhead))
                        end
                    end
                end
            else
                isRunning = false
            end
            task.wait(0.016)
        end

        isRunning = false
        isJumping = false
    end)
end


local function ResolveUser(username)
    username = tostring(username or ""):lower():gsub("%s+", "")
    if username == "" then return nil end

    -- 1. Numeric UserId support
    if tonumber(username) then
        local numId = tonumber(username)
        local actualName = "User_" .. numId
        local displayName = actualName
        local isVerified = false
        pcall(function()
            local info = UserService:GetUserInfosByUserIdsAsync({numId})[1]
            if info then
                actualName = info.Username or actualName
                displayName = info.DisplayName or actualName
                if info.HasVerifiedBadge ~= nil then
                    isVerified = (info.HasVerifiedBadge == true)
                end
            end
        end)
        return {
            Name = actualName,
            DisplayName = displayName,
            UserId = numId,
            IsVerified = isVerified
        }
    end

    -- 2. Exact match in server
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == username or p.DisplayName:lower() == username then
            local isVerified = false
            pcall(function()
                local info = UserService:GetUserInfosByUserIdsAsync({p.UserId})[1]
                if info and info.HasVerifiedBadge ~= nil then
                    isVerified = (info.HasVerifiedBadge == true)
                end
            end)
            return {
                Name = p.Name,
                DisplayName = p.DisplayName or p.Name,
                UserId = p.UserId,
                IsVerified = isVerified,
                Player = p
            }
        end
    end

    -- 3. Substring match in server
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(username, 1, true) or p.DisplayName:lower():find(username, 1, true) then
            local isVerified = false
            pcall(function()
                local info = UserService:GetUserInfosByUserIdsAsync({p.UserId})[1]
                if info and info.HasVerifiedBadge ~= nil then
                    isVerified = (info.HasVerifiedBadge == true)
                end
            end)
            return {
                Name = p.Name,
                DisplayName = p.DisplayName or p.Name,
                UserId = p.UserId,
                IsVerified = isVerified,
                Player = p
            }
        end
    end

    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and userId then
        local actualName = username
        local displayName = username
        local isVerified = false
        pcall(function()
            local info = UserService:GetUserInfosByUserIdsAsync({userId})[1]
            if info then
                actualName = info.Username or username
                displayName = info.DisplayName or actualName
                if info.HasVerifiedBadge ~= nil then
                    isVerified = (info.HasVerifiedBadge == true)
                end
            end
        end)
        return {
            Name = actualName,
            DisplayName = displayName,
            UserId = userId,
            IsVerified = isVerified,
            Player = nil
        }
    end

    return nil
end

local function GetSafezoneCFrame()
    local spawnLoc = workspace:FindFirstChild("SpawnLocation")
    if spawnLoc and spawnLoc:IsA("BasePart") then
        return spawnLoc.CFrame + Vector3.new(0, 4, 0)
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        local safe = map:FindFirstChild("SafeZone") or map:FindFirstChild("Safezone") or map:FindFirstChild("Spawn")
        if safe then
            return safe:IsA("BasePart") and safe.CFrame or safe:GetPivot()
        end
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return LocalPlayer.Character.HumanoidRootPart.CFrame
    end
    return CFrame.new(0, 50, 0)
end

local cachedRayParams = RaycastParams.new()
cachedRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function GetGroundHeight(pos, ignoreList, defaultOffset)
    defaultOffset = defaultOffset or 0
    local rayOrigin = Vector3.new(pos.X, pos.Y + 18, pos.Z)
    local fullIgnore = {}
    if ignoreList then
        for _, inst in ipairs(ignoreList) do
            if inst then table.insert(fullIgnore, inst) end
        end
    end
    local spawnedEggs = workspace:FindFirstChild("ServerConsole_SpawnedEggs")
    if spawnedEggs then
        table.insert(fullIgnore, spawnedEggs)
    end
    local placedRenders = workspace:FindFirstChild("PlacedEggRenders")
    if placedRenders then
        table.insert(fullIgnore, placedRenders)
    end
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        table.insert(fullIgnore, plots)
    end
    local stands = workspace:FindFirstChild("Stands")
    if stands then
        table.insert(fullIgnore, stands)
    end
    cachedRayParams.FilterDescendantsInstances = fullIgnore

    local hit = workspace:Raycast(rayOrigin, Vector3.new(0, -60, 0), cachedRayParams)
    if hit then
        -- Secondary check: if hit part belongs to an egg model in Workspace, punch through down to ground
        local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
        if hitModel and (hitModel.Name:lower():find("egg") or (spawnedEggs and hitModel.Parent == spawnedEggs)) then
            local nextOrigin = Vector3.new(pos.X, hit.Position.Y - 0.2, pos.Z)
            local secondaryHit = workspace:Raycast(nextOrigin, Vector3.new(0, -50, 0), cachedRayParams)
            if secondaryHit then
                return secondaryHit.Position.Y + defaultOffset
            end
        end
        return hit.Position.Y + defaultOffset
    end
    return pos.Y + defaultOffset
end


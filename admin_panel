local TARGET_KITSUNE_BOUNDS = 36.0

local function GetWorldVisibleBounds(model)
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local count = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower() ~= "hitbox" and d.Name:lower() ~= "customboundingbox" and d.Name ~= "EggRootPart" and d.Transparency < 0.95 then
            count = count + 1
            local cf = d.CFrame
            local hs = d.Size * 0.5
            for _, corner in ipairs({
                cf:PointToWorldSpace(Vector3.new(hs.X, hs.Y, hs.Z)),
                cf:PointToWorldSpace(Vector3.new(hs.X, hs.Y, -hs.Z)),
                cf:PointToWorldSpace(Vector3.new(hs.X, -hs.Y, hs.Z)),
                cf:PointToWorldSpace(Vector3.new(hs.X, -hs.Y, -hs.Z)),
                cf:PointToWorldSpace(Vector3.new(-hs.X, hs.Y, hs.Z)),
                cf:PointToWorldSpace(Vector3.new(-hs.X, hs.Y, -hs.Z)),
                cf:PointToWorldSpace(Vector3.new(-hs.X, -hs.Y, hs.Z)),
                cf:PointToWorldSpace(Vector3.new(-hs.X, -hs.Y, -hs.Z)),
            }) do
                minX = math.min(minX, corner.X)
                minY = math.min(minY, corner.Y)
                minZ = math.min(minZ, corner.Z)
                maxX = math.max(maxX, corner.X)
                maxY = math.max(maxY, corner.Y)
                maxZ = math.max(maxZ, corner.Z)
            end
        end
    end
    if count == 0 then
        local cf, sz = model:GetBoundingBox()
        return cf.Position, sz
    end
    local center = Vector3.new((minX + maxX)/2, (minY + maxY)/2, (minZ + maxZ)/2)
    local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
    return center, size
end

local function OrientEggUpright(model)
    local center, sz = GetWorldVisibleBounds(model)
    -- Rotate eggs that are modeled lying flat on their side (length X or Z >= 1.6x height Y)
    if sz.X > sz.Y * 1.6 and sz.X >= sz.Z then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.new(-center) * p.CFrame
            end
        end
    elseif sz.Z > sz.Y * 1.6 and sz.Z >= sz.X then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CFrame = CFrame.new(center) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.new(-center) * p.CFrame
            end
        end
    end
end

local function CalculateKitsuneNormalizedScale(sourceModel)
    local _, sz = GetWorldVisibleBounds(sourceModel)
    local heightY = sz.Y
    if heightY <= 0.1 then heightY = 5.37 end
    return TARGET_KITSUNE_BOUNDS / heightY
end

local function SpawnSingleEggInstance(sourceModel, targetPosition, eggScale, rarityType)
    local eggClone = sourceModel:Clone()

    for _, p in ipairs(eggClone:GetDescendants()) do
        if p:IsA("BasePart") and (p.Name:lower() == "hitbox" or p.Name:lower() == "customboundingbox") then
            p:Destroy()
        end
    end

    local mName = (sourceModel.Name or ""):lower()
    local cName = (eggClone.Name or ""):lower()
    local isWorldBurner = mName:find("world burner") ~= nil 
        or mName:find("worldburner") ~= nil
        or cName:find("world burner") ~= nil
        or cName:find("worldburner") ~= nil

    -- Ensure egg is standing upright (fixes horizontal eggs like Unicorn, ArchAngel, etc.)
    -- ONLY World Burner remains horizontal!
    if not isWorldBurner then
        OrientEggUpright(eggClone)
    end

    -- Calculate scale multiplier:
    -- All eggs match Kitsune egg vertical height (36.0 studs - 2X bigger).
    -- World Burner remains horizontal and 2X bigger (scale 2.10x, height ~26.4 studs, length ~52.8 studs).
    local scaleFactor
    if isWorldBurner then
        scaleFactor = 2.10
    else
        scaleFactor = CalculateKitsuneNormalizedScale(eggClone)
    end
    if eggScale and eggScale ~= 5.0 then
        scaleFactor = scaleFactor * (eggScale / 5.0)
    end

    pcall(function()
        if eggClone:IsA("Model") then
            eggClone:ScaleTo(eggClone:GetScale() * scaleFactor)
        elseif eggClone:IsA("BasePart") then
            eggClone.Size = eggClone.Size * scaleFactor
        end
    end)

    local finalScale = eggClone:IsA("Model") and eggClone:GetScale() or 1.0

    for _, p in ipairs(eggClone:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
            p.Anchored = true
        end
    end

    -- Attach authentic in-game egg effects scaled to fit the egg model
    AttachGameEggEffects(eggClone, sourceModel, rarityType, scaleFactor)

    -- Align model pivot to the accurate visual geometric center via an upright EggRootPart
    local center, accurateSize = GetWorldVisibleBounds(eggClone)
    local rootPart = Instance.new("Part")
    rootPart.Name = "EggRootPart"
    rootPart.Size = Vector3.new(1, 1, 1)
    rootPart.CFrame = CFrame.new(center)
    rootPart.Transparency = 1
    rootPart.CanCollide = false
    rootPart.CanTouch = false
    rootPart.CanQuery = false
    rootPart.Anchored = true
    rootPart.Parent = eggClone
    eggClone.PrimaryPart = rootPart

    local halfHeight = (accurateSize.Y > 0 and accurateSize.Y or 12) / 2
    local groundY = GetGroundHeight(targetPosition, {LocalPlayer.Character, CreatedEggsFolder}, 0)

    -- Prevent eggs from spawning on top of boundary walls or cliffs (playable arena floor is Y <= 73.5)
    if groundY > 74.0 then
        eggClone:Destroy()
        return nil
    end

    -- Face towards the entrance / player (West, -X direction)
    local finalEggCFrame = CFrame.new(targetPosition.X, groundY + halfHeight + 0.15, targetPosition.Z) * CFrame.Angles(0, math.rad(90), 0)

    -- Save original spawn position so held eggs can return to their old position
    local cfVal = Instance.new("CFrameValue")
    cfVal.Name = "OriginalSpawnCFrame"
    cfVal.Value = finalEggCFrame
    cfVal.Parent = eggClone
    eggClone:SetAttribute("OriginalSpawnCFrame", finalEggCFrame)

    eggClone.Parent = CreatedEggsFolder

    -- Juicy drop & pop-in bounce animation
    task.spawn(function()
        local dropHeight = 16.0
        local animDuration = 0.42
        local startTime = os.clock()

        pcall(function()
            if eggClone:IsA("Model") then
                eggClone:ScaleTo(finalScale * 0.18)
                eggClone:PivotTo(finalEggCFrame * CFrame.new(0, dropHeight, 0))
            elseif eggClone:IsA("BasePart") then
                eggClone.Size = eggClone.Size * 0.18
                eggClone.CFrame = finalEggCFrame * CFrame.new(0, dropHeight, 0)
            end
        end)

        local RunService = game:GetService("RunService")
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not eggClone or not eggClone.Parent then
                if conn then conn:Disconnect() end
                return
            end
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / animDuration, 0, 1)

            local yOffset = 0
            local currentScaleMult = 1.0

            if alpha < 0.65 then
                local t = alpha / 0.65
                yOffset = dropHeight * (1 - t * t)
                currentScaleMult = 0.18 + (1.15 - 0.18) * math.sin(t * math.pi / 2)
            else
                local t = (alpha - 0.65) / 0.35
                yOffset = math.sin(t * math.pi) * 2.2
                currentScaleMult = 1.15 - 0.15 * t
            end

            local curCF = finalEggCFrame * CFrame.new(0, yOffset, 0)

            pcall(function()
                if eggClone:IsA("Model") then
                    eggClone:ScaleTo(finalScale * currentScaleMult)
                    eggClone:PivotTo(curCF)
                elseif eggClone:IsA("BasePart") then
                    eggClone.CFrame = curCF
                end
            end)

            if alpha >= 1 then
                conn:Disconnect()
                pcall(function()
                    if eggClone:IsA("Model") then
                        eggClone:ScaleTo(finalScale)
                        eggClone:PivotTo(finalEggCFrame)
                    elseif eggClone:IsA("BasePart") then
                        eggClone.CFrame = finalEggCFrame
                    end
                end)
                pcall(function()
                    local snd = Instance.new("Sound")
                    snd.SoundId = "rbxassetid://6026986407"
                    snd.Volume = 0.45
                    snd.Parent = SoundService
                    snd:Play()
                    snd.Ended:Connect(function() snd:Destroy() end)
                end)
            end
        end)
    end)

    return eggClone
end


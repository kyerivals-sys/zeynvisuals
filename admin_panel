local function SetupResizeGrip(gripButton, mode)
    local isResizing = false
    local resizeStartMouse = Vector2.zero
    local resizeStartSize = Vector2.zero
    local moveConn = nil
    local releaseConn = nil

    local function EndResize()
        if isResizing then
            isResizing = false
            if moveConn then moveConn:Disconnect() moveConn = nil end
            if releaseConn then releaseConn:Disconnect() releaseConn = nil end
        end
    end

    gripButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if IsMinimized then return end
            isResizing = true
            resizeStartMouse = Vector2.new(input.Position.X, input.Position.Y)
            resizeStartSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)

            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if isResizing and (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) then
                    local delta = Vector2.new(moveInput.Position.X, moveInput.Position.Y) - resizeStartMouse
                    local cam = workspace.CurrentCamera
                    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
                    local maxW = math.max(680, vp.X - MainFrame.AbsolutePosition.X - 10)
                    local maxH = math.max(420, vp.Y - MainFrame.AbsolutePosition.Y - 10)

                    local newW = resizeStartSize.X
                    local newH = resizeStartSize.Y

                    if mode == "right" or mode == "corner" then
                        newW = math.clamp(resizeStartSize.X + delta.X, 480, maxW)
                    end
                    if mode == "bottom" or mode == "corner" then
                        newH = math.clamp(resizeStartSize.Y + delta.Y, 260, maxH)
                    end

                    MainFrame.Size = UDim2.new(0, newW, 0, newH)
                    CurrentRestoredSize = Vector2.new(newW, newH)
                end
            end)

            releaseConn = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                    EndResize()
                end
            end)
        end
    end)
end

SetupResizeGrip(RightResizeGrip, "right")

    elseif cmd == "givedeveloper" or cmd == "givedev" then
        local target = args[2] or ""
        if target:gsub("%s+", "") == "" then
            AddLog("Please specify a username! Usage: givedeveloper <username>", "WARNING")
        else
            ExecGiveDeveloper(target)
        end
    elseif cmd == "giveps" then
        local target = args[2] or ""
        ExecGivePS(target)
    elseif cmd == "setprofile" then
        local target = args[2] or ""
        local forceVerify = args[3]
        ExecSetProfile(target, forceVerify)
    elseif cmd == "setrole" then
        local roleInput = args[2] or ""
        ExecSetRole(roleInput)
    elseif cmd == "followrole" or cmd == "botrole" then
        local roleInput = (args[2] or ""):upper():gsub("%s+", "")
        if roleInput == "" then
            AddLog("Usage: followrole CREATOR | DEVELOPER | ADMIN | NONE", "WARNING")
        elseif not ActiveFollowerBot or not ActiveFollowerBot.Parent then
            AddLog("No active follow bot! Start one with: follow <username>", "ERROR")
        elseif roleInput == "NONE" or roleInput == "CLEAR" or roleInput == "REMOVE" then
            local head = ActiveFollowerBot:FindFirstChild("Head") or ActiveFollowerBot.PrimaryPart
            if head then
                local existing = head:FindFirstChild("ServerConsole_OverheadRole")
                if existing then existing:Destroy() end
            end
            AddLog("Follow bot overhead role cleared.", "WARNING")
        elseif not RolePalettes[roleInput] then
            AddLog(string.format("Invalid role '%s'. Available: CREATOR (Red), DEVELOPER (Blue), ADMIN (Gold)", roleInput), "ERROR")
        else
            ApplyCharacterOverheadRole(ActiveFollowerBot, roleInput)
            AddLog(string.format("Applied [%s] role to follow bot!", roleInput), "SUCCESS")
        end
    elseif cmd == "morph" then
        local target = args[2] or ""
        ExecMorph(target)
    elseif cmd == "boostevent" or cmd == "boost" then
        ExecBoostEvent(args)
    elseif cmd == "/help" or cmd == "help" then
        ExecHelp()
    else
        AddLog(string.format("Unknown command '%s'. Type /help for available commands.", cmd), "ERROR")
    end
end

_G.ProcessServerConsoleCommand = ProcessCommand

-- Connect chat listener so typing 'mix' or any console command in Roblox chat triggers execution
local function HandleChatMessage(rawMsg)
    if type(rawMsg) ~= "string" then return end
    local msg = rawMsg:match("^%s*(.-)%s*$")
    if msg == "" then return end
    
    if msg:sub(1, 3):lower() == "/e " then
        msg = msg:sub(4)
    elseif msg:sub(1, 1) == "/" and not msg:lower():find("^/help") then
        msg = msg:sub(2)
    end
    msg = msg:match("^%s*(.-)%s*$")
    
    local firstWord = msg:split(" ")[1] and msg:split(" ")[1]:lower() or ""
    local validChatCmds = {
        ["mix"] = true,
        ["spawnmixegg"] = true,
        ["mixegg"] = true,
        ["spawnmix"] = true,
        ["spawnegg"] = true,
        ["spawegg"] = true,
        ["cleareggs"] = true,
        ["clearegg"] = true,
        ["teleport"] = true,
        ["follow"] = true,
        ["clearbot"] = true,
        ["clearbots"] = true,
        ["boostevent"] = true,
        ["boost"] = true,
        ["setrole"] = true,
        ["followrole"] = true,
        ["botrole"] = true,
        ["morph"] = true,
        ["announce"] = true,
        ["giveadmin"] = true,
        ["givedeveloper"] = true,
        ["givedev"] = true,
        ["tptome"] = true,
        ["tp2me"] = true,
        ["bot2me"] = true,
        ["teleporttome"] = true,
        ["giveps"] = true,
        ["setprofile"] = true,
        ["help"] = true,
        ["/help"] = true,
    }
    
    if validChatCmds[firstWord] then
        ProcessCommand(msg)
    end
end

pcall(function()
    LocalPlayer.Chatted:Connect(function(msg)
        HandleChatMessage(msg)
    end)
end)

pcall(function()
    local TextChatService = game:GetService("TextChatService")
    TextChatService.MessageReceived:Connect(function(textChatMessage)
        if textChatMessage.TextSource and textChatMessage.TextSource.UserId == LocalPlayer.UserId then
            HandleChatMessage(textChatMessage.Text)
        end
    end)
end)


-- TOOL PRESERVATION SAFEGUARD (Never lose Bat, Katana, Eggs, Traps)
----------------------------------------------------------------
local function EnsureToolGrip(tool)
    if not tool or not tool:IsA("Tool") then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return end
    handle.CanCollide = false

    local character = LocalPlayer.Character
    if not character then return end
    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if not rightHand or not rightHand:IsA("BasePart") then return end

    local existingGrip = nil
    for _, child in ipairs(rightHand:GetChildren()) do
        if child:IsA("Weld") and child.Name == "RightGrip" then
            if child.Part0 == rightHand and child.Part1 == handle then
                if not existingGrip then
                    existingGrip = child
                else
                    child:Destroy()
                end
            else
                child:Destroy()
            end
        end
    end

    if existingGrip then return end

    local newGrip = Instance.new("Weld")
    newGrip.Name = "RightGrip"
    newGrip.Part0 = rightHand
    newGrip.Part1 = handle
    local att = rightHand:FindFirstChild("RightGripAttachment")
    if att then
        newGrip.C0 = att.CFrame
    else
        newGrip.C0 = CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)
    end
    newGrip.C1 = tool.Grip
    newGrip.Parent = rightHand
end

local function BindCharacterToolGuard(character)
    if not character then return end
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.defer(function()
                EnsureToolGrip(child)
            end)
        end
    end)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            EnsureToolGrip(child)
        end
    end
end

LocalPlayer.CharacterAdded:Connect(BindCharacterToolGuard)
if LocalPlayer.Character then
    BindCharacterToolGuard(LocalPlayer.Character)
end

RunService.Stepped:Connect(function()
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            local rh = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
            if handle and rh then
                local grip = rh:FindFirstChild("RightGrip") or handle:FindFirstChild("RightGrip")
                if not grip or grip.Part0 ~= rh or grip.Part1 ~= handle then
                    EnsureToolGrip(tool)
                end
            end
        end
    end
end)


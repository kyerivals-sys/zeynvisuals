local function IsPetModel(obj)
    if not obj or not obj:IsA("Model") then return false end
    -- Check for humanoid parts / pet rig identifiers
    if obj:FindFirstChild("HumanoidRootPart") 
        or obj:FindFirstChild("CENTER") 
        or obj:FindFirstChild("Humanoid") 
        or obj:FindFirstChild("AnimationController")
        or obj:FindFirstChildWhichIsA("Accessory") then
        return true
    end
    -- Check parent folder: AssetModels and Assets.Models contain pet character rigs
    local parent = obj.Parent
    if parent then
        if parent.Name == "AssetModels" then return true end
        if parent.Name == "Models" and parent.Parent and parent.Parent.Name == "Assets" then return true end
    end
    return false
end


local function FindTargetEgg(spec)
    local eggsFolder = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Models") and ReplicatedStorage.Assets.Models:FindFirstChild("Eggs")
    -- Direct match in Eggs folder first (guaranteed genuine egg model, never a pet)
    if eggsFolder and spec.direct then
        local directObj = eggsFolder:FindFirstChild(spec.direct)
        if directObj and directObj:IsA("Model") and not IsPetModel(directObj) then
            return directObj
        end
    end

    for _, alias in ipairs(spec.aliases) do
        local clean = alias:lower():gsub("%s+", ""):gsub("[#_]", "")
        if ScannedEggsCache.Lookup[clean] and not IsPetModel(ScannedEggsCache.Lookup[clean]) then
            return ScannedEggsCache.Lookup[clean]
        end
    end
    for _, alias in ipairs(spec.aliases) do
        local clean = alias:lower():gsub("%s+", ""):gsub("[#_]", "")
        for key, model in pairs(ScannedEggsCache.Lookup) do
            if (key == clean or key:find(clean, 1, true) or clean:find(key, 1, true)) and not IsPetModel(model) then
                return model
            end
        end
    end

    -- Search strictly EGG containers (NEVER AssetModels or Models)
    local searchContainers = {
        eggsFolder,
        workspace:FindFirstChild("PlacedEggRenders"),
        workspace:FindFirstChild("Eggs")
    }
    for _, container in ipairs(searchContainers) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Model") and not IsPetModel(obj) then
                    local objName = obj.Name:lower():gsub("%s+", ""):gsub("[#_]", "")
                    for _, alias in ipairs(spec.aliases) do
                        local clean = alias:lower():gsub("%s+", ""):gsub("[#_]", "")
                        if objName == clean or objName:find(clean, 1, true) or clean:find(objName, 1, true) then
                            ScannedEggsCache.Lookup[clean] = obj
                            return obj
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function ScanAllGameEggs()
    local allList = {}
    local divineList = {}
    local limitedList = {}
    local lookup = {}
    local seen = {}

    local eggsFolder = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Models") and ReplicatedStorage.Assets.Models:FindFirstChild("Eggs")
    local searchContainers = {
        eggsFolder,
        workspace:FindFirstChild("PlacedEggRenders"),
        workspace:FindFirstChild("Eggs")
    }

    for _, container in ipairs(searchContainers) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("Model") and not seen[obj] and not IsPetModel(obj) then
                    local nameLow = obj.Name:lower()
                    local cleanName = nameLow:gsub("%s+", ""):gsub("[#_]", "")

                    local isEgg = nameLow:find("egg") 
                        or (obj.Parent and obj.Parent.Name:lower():find("egg"))
                        or obj:FindFirstChild("Hitbox") ~= nil

                    if not isEgg then
                        for _, spec in ipairs(TARGET_DIVINE_SPECS) do
                            for _, al in ipairs(spec.aliases) do
                                if cleanName == al:lower():gsub("%s+", ""):gsub("[#_]", "") then
                                    isEgg = true
                                    break
                                end
                            end
                            if isEgg then break end
                        end
                    end

                    if not isEgg then
                        for _, spec in ipairs(TARGET_LIMITED_SPECS) do
                            for _, al in ipairs(spec.aliases) do
                                if cleanName == al:lower():gsub("%s+", ""):gsub("[#_]", "") then
                                    isEgg = true
                                    break
                                end
                            end
                            if isEgg then break end
                        end
                    end

                    if isEgg then
                        seen[obj] = true
                        table.insert(allList, obj)
                        lookup[cleanName] = obj

                        local fusionTier = tostring(obj:GetAttribute("FusionTier") or ""):lower()
                        local rarityAttr = tostring(obj:GetAttribute("Rarity") or obj:GetAttribute("EggRarity") or ""):lower()

                        -- STRICT BLACKLIST: Absolutely NO Secret or Eternal eggs in Divine or Limited
                        local isSecretOrEternal = fusionTier:find("eternal")
                            or rarityAttr:find("eternal")
                            or rarityAttr:find("secret")
                            or cleanName:find("secret")
                            or cleanName:find("skeletonhorse")
                            or cleanName:find("pegasus")
                            or cleanName:find("equinox")
                            or cleanName:find("worldeater")

                        if not isSecretOrEternal then
                            local isTargetDivine = false
                            for _, spec in ipairs(TARGET_DIVINE_SPECS) do
                                for _, al in ipairs(spec.aliases) do
                                    if cleanName == al:lower():gsub("%s+", ""):gsub("[#_]", "") then
                                        isTargetDivine = true
                                        break
                                    end
                                end
                                if isTargetDivine then break end
                            end

                            local isTargetLimited = false
                            for _, spec in ipairs(TARGET_LIMITED_SPECS) do
                                for _, al in ipairs(spec.aliases) do
                                    if cleanName == al:lower():gsub("%s+", ""):gsub("[#_]", "") then
                                        isTargetLimited = true
                                        break
                                    end
                                end
                                if isTargetLimited then break end
                            end

                            if isTargetDivine or fusionTier:find("divine") or rarityAttr:find("divine") then
                                table.insert(divineList, obj)
                            elseif isTargetLimited or cleanName:find("limited") or cleanName:find("rift") or cleanName:find("monster") then
                                table.insert(limitedList, obj)
                            end
                        end
                    end
                end
            end
        end
    end

    ScannedEggsCache.All = allList
    ScannedEggsCache.Divine = divineList
    ScannedEggsCache.Limited = limitedList
    ScannedEggsCache.Lookup = lookup

    return ScannedEggsCache
end


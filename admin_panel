local function ProcessCommand(fullCmd)
    fullCmd = fullCmd:match("^%s*(.-)%s*$")
    if fullCmd == "" then return end

    AddLog("> " .. fullCmd, "INFO")
    
    local args = {}
    for word in fullCmd:gmatch("%S+") do
        table.insert(args, word)
    end

    local cmd = args[1]:lower()

    if cmd == "spawnegg" then
        local eggName = args[2] or "Egg"
        local amount = tonumber(args[3]) or 1
        if eggName:lower() == "clear" or eggName:lower() == "stop" then
            if CreatedEggsFolder then
                CreatedEggsFolder:ClearAllChildren()
                AddLog("Cleared all spawned eggs!", "WARNING")
            end
            return
        end
        if eggName:lower() == "mix" or eggName:lower() == "mixegg" or eggName:lower() == "spawnmixegg" then
            SpawnMixEgg(tonumber(args[3]) or 25)
            return
        end
        if tonumber(args[2]) and not tonumber(args[3]) then
            amount = tonumber(args[2]) or 1
            eggName = args[3] or "Egg"
        end
        FindAndSpawnEgg(eggName, amount)
    elseif cmd == "spawnmixegg" or cmd == "mixegg" or cmd == "mix" then
        local arg2 = args[2] and args[2]:lower() or ""
        if arg2 == "clear" or arg2 == "stop" then
            if CreatedEggsFolder then
                CreatedEggsFolder:ClearAllChildren()
                AddLog("Cleared all spawned eggs!", "WARNING")
            end
            return
        end
        local amount = tonumber(args[2]) or tonumber(args[3])
        SpawnMixEgg(amount)
    elseif cmd == "cleareggs" or cmd == "clearegg" then
        if CreatedEggsFolder then
            CreatedEggsFolder:ClearAllChildren()
            AddLog("Cleared all spawned eggs!", "WARNING")
        end
        return
    elseif cmd == "setverify" or cmd == "verify" then
        local state = args[2] and args[2]:lower() or ""
        if state == "off" or state == "false" or state == "disable" or state == "0" then
            ActiveProfile.IsVerified = false
            AddLog("Verified badge DISABLED for active profile.", "WARNING")
        else
            ActiveProfile.IsVerified = true
            AddLog("Verified badge ENABLED for active profile!", "SUCCESS")
        end
    elseif cmd == "teleport" then
        local target = args[2] or ""
        ToggleTeleportBot(target)
    elseif cmd == "followme" or cmd == "follow" then
        local target = args[2] or ""
        ExecFollowMe(target)
    elseif cmd == "announce" then
        local msgText = table.concat(args, " ", 2)
        ExecAnnounce(msgText)
    elseif cmd == "giveadmin" then
        local target = args[2] or ""
        ExecGiveAdmin(target)
    elseif cmd == "giveps" then
        local target = args[2] or ""
        ExecGivePS(target)
    elseif cmd == "setprofile" then
        local target = args[2] or ""
        local forceVerify = args[3]
        ExecSetProfile(target, forceVerify)
    elseif cmd == "setrole" then
        local roleInput = args[2] or ""
        ExecSetRole(roleInput)
    elseif cmd == "morph" then
        local target = args[2] or ""
        ExecMorph(target)
    elseif cmd == "/help" or cmd == "help" then
        ExecHelp()
    else
        AddLog(string.format("Unknown command '%s'. Type /help for available commands.", cmd), "ERROR")
    end
end

RunBtn.MouseButton1Click:Connect(function()
    local textToExec = CmdTextBox.Text
    CmdTextBox.Text = ""
    ProcessCommand(textToExec)
end)

CmdTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local textToExec = CmdTextBox.Text
        CmdTextBox.Text = ""
        ProcessCommand(textToExec)
    end
end)


local function GetModelOrPartBounds(obj)
    if not obj then return CFrame.new(), Vector3.new(4, 4, 4) end
    if obj:IsA("Model") then
        local cf, sz = obj:GetBoundingBox()
        return cf, sz
    elseif obj:IsA("BasePart") then
        return obj.CFrame, obj.Size
    end
    return CFrame.new(), Vector3.new(4, 4, 4)
end

local function DetectEggRarity(eggNameOrModel)
    local rawName = ""
    if typeof(eggNameOrModel) == "Instance" then
        rawName = eggNameOrModel.Name
    elseif type(eggNameOrModel) == "string" then
        rawName = eggNameOrModel
    end
    local clean = rawName:lower():gsub("%s+", ""):gsub("[#_]", "")

    -- 1. Divine targets check
    for _, spec in ipairs(TARGET_DIVINE_SPECS) do
        for _, al in ipairs(spec.aliases) do
            local cleanAl = al:lower():gsub("%s+", ""):gsub("[#_]", "")
            if clean == cleanAl or clean:find(cleanAl, 1, true) or cleanAl:find(clean, 1, true) then
                return "Divine"
            end
        end
    end
    if clean:find("divine") or clean:find("kitsune") or clean:find("aetheron") or clean:find("worldburner") or clean:find("archdemon") or clean:find("archangel") or clean:find("unicorn") or clean:find("nightflame") then
        return "Divine"
    end

    -- 2. Eternal targets check
    local eternalKeywords = {
        "eternal", "balrog", "worldeater", "eternallunar", "onitiger",
        "terrasnapper", "krakenoid", "voiddragon", "skeletondragon", "elmaja"
    }
    for _, kw in ipairs(eternalKeywords) do
        if clean:find(kw, 1, true) then
            return "Eternal"
        end
    end

    -- 3. Limited targets check
    for _, spec in ipairs(TARGET_LIMITED_SPECS) do
        for _, al in ipairs(spec.aliases) do
            local cleanAl = al:lower():gsub("%s+", ""):gsub("[#_]", "")
            if clean == cleanAl or clean:find(cleanAl, 1, true) or cleanAl:find(clean, 1, true) then
                return "Limited"
            end
        end
    end
    if clean:find("limited") or clean:find("rift") or clean:find("brainrot") or clean:find("luminous") or clean:find("experiment") or clean:find("nibbles") then
        return "Limited"
    end

    -- 4. Check ReplicatedStorage.Data.Assets if available in game
    local success, Assets = pcall(function()
        return require(ReplicatedStorage.Data.Assets)
    end)
    if success and Assets and Assets.Directory then
        for assetName, data in pairs(Assets.Directory) do
            local assetClean = assetName:lower():gsub("%s+", ""):gsub("[#_]", "")
            if clean == assetClean or clean:find(assetClean, 1, true) or assetClean:find(clean, 1, true) then
                if data.Rarity then
                    local rDisp = tostring(data.Rarity.DisplayName or ""):lower()
                    local rId = tostring(data.Rarity._id or ""):lower()
                    if rDisp == "divine" or rId == "divine" then return "Divine" end
                    if rDisp == "eternal" or rId == "eternal" then return "Eternal" end
                    if rDisp == "limited" or rId == "limited" then return "Limited" end
                end
            end
        end
    end

    return "Divine"
end

local function AttachGameEggEffects(eggClone, sourceModel, rarityType, eggScale)
    local targetPart = eggClone.PrimaryPart or eggClone:FindFirstChildWhichIsA("BasePart")
    if not targetPart then
        for _, p in ipairs(eggClone:GetDescendants()) do
            if p:IsA("BasePart") then
                targetPart = p
                break
            end
        end
    end
    if not targetPart then return end

    local scaleMultiplier = eggScale or 5.0

    local isUnicorn = sourceModel.Name:lower():find("unicorn") ~= nil
    if isUnicorn then
        -- Preserve and enable Unicorn's authentic 12-layer rainbow sparkles and PointLight
        for _, fx in ipairs(eggClone:GetDescendants()) do
            if fx:IsA("ParticleEmitter") or fx:IsA("PointLight") or fx:IsA("SurfaceLight") or fx:IsA("SpotLight") or fx:IsA("Beam") or fx:IsA("Trail") then
                fx.Enabled = true
            end
        end
        return
    end

    -- Enable built-in custom model particles (Riftbeasts, Riftborn, Abyss Overlord, Drill Monster, Godzilla, etc.)
    for _, fx in ipairs(eggClone:GetDescendants()) do
        if fx:IsA("ParticleEmitter") then
            fx.Enabled = true
            fx.Rate = math.clamp(fx.Rate * 0.20, 0.4, 3.5)
        elseif fx:IsA("PointLight") or fx:IsA("SpotLight") or fx:IsA("SurfaceLight") then
            fx.Enabled = true
            fx.Shadows = false
        elseif fx:IsA("Beam") or fx:IsA("Trail") then
            fx.Enabled = true
        end
    end

    -- Attach authentic in-game EggRarityVFX from ReplicatedStorage
    local vfxFolder = ReplicatedStorage:FindFirstChild("Assets")
        and ReplicatedStorage.Assets:FindFirstChild("Particles")
        and ReplicatedStorage.Assets.Particles:FindFirstChild("EggRarityVFX")

    if vfxFolder then
        local isSecret = (rarityType == "Secret") or (sourceModel.Name:lower():find("jellyfish") ~= nil)

        local cloneAtt = nil

        if isSecret then
            -- RarityNumber8: Rainbow Glow, Rainbow Flares & Rainbow Stars
            local tierFolder = vfxFolder:FindFirstChild("RarityNumber8")
            if tierFolder then
                local att = tierFolder:FindFirstChild("Attachment")
                if att then
                    cloneAtt = att:Clone()
                    cloneAtt.Name = "EggRarityFX"
                    cloneAtt.Parent = targetPart
                end
            end
        else
            -- RarityNumber9+: Radiant Gold Glow, Rotating God Rays, Vortex Intake, Flares & Golden Stars
            local tierFolder = vfxFolder:FindFirstChild("RarityNumber9+")
            if tierFolder then
                local fxAtt = tierFolder:FindFirstChild("FX")
                if fxAtt then
                    cloneAtt = fxAtt:Clone()
                    cloneAtt.Name = "EggRarityFX"
                    cloneAtt.Parent = targetPart

                    for _, child in ipairs(tierFolder:GetChildren()) do
                        if child:IsA("ParticleEmitter") then
                            local peClone = child:Clone()
                            peClone.Parent = cloneAtt
                        end
                    end
                end
            end
        end

        if cloneAtt then
            -- Center the attachment directly at the geometric center of the egg
            local cf, bSize = GetModelOrPartBounds(eggClone)
            if cf and targetPart then
                cloneAtt.Position = targetPart.CFrame:PointToObjectSpace(cf.Position)
            end

            -- Scale and throttle all particles proportionally so 70 eggs render with high FPS!
            for _, emitter in ipairs(cloneAtt:GetChildren()) do
                if emitter:IsA("ParticleEmitter") then
                    emitter.Enabled = true
                    emitter.Rate = math.clamp(emitter.Rate * 0.15, 0.5, 3.0)
                    pcall(function()
                        local newKeypoints = {}
                        for _, kp in ipairs(emitter.Size.Keypoints) do
                            table.insert(newKeypoints, NumberSequenceKeypoint.new(
                                kp.Time,
                                kp.Value * scaleMultiplier,
                                (kp.Envelope or 0) * scaleMultiplier
                            ))
                        end
                        emitter.Size = NumberSequence.new(newKeypoints)
                    end)
                elseif emitter:IsA("Light") then
                    emitter.Shadows = false
                end
            end
        end
    end
end


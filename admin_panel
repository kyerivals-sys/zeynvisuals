                shakeActive = true
                local sStart = os.clock()
                while (os.clock() - sStart) < duration do
                    local progress = math.clamp((os.clock() - sStart) / duration, 0, 1)
                    local decay = (1 - progress) * (1 - progress)
                    shakeOffset = Vector3.new(
                        (math.random() - 0.5) * intensity * decay,
                        (math.random() - 0.5) * intensity * decay,
                        (math.random() - 0.5) * (intensity * 0.5) * decay
                    )
                    shakeRoll = (math.random() - 0.5) * math.rad(3.5) * decay
                    RunService.RenderStepped:Wait()
                end

local function ExecMorph(targetUsername)
    if not targetUsername or targetUsername == "" then
        AddLog("Usage: morph <robloxusername>", "ERROR")
        return
    end

    AddLog(string.format("Morphing avatar into '%s'...", targetUsername), "INFO")

    task.spawn(function()
        local userRes = ResolveUser(targetUsername)
        if not userRes then
            AddLog(string.format("Could not resolve user '%s'", targetUsername), "ERROR")
            return
        end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChildOfClass("Humanoid") then
            AddLog("Local character or Humanoid not found!", "ERROR")
            return
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not hrp then
            AddLog("HumanoidRootPart not found!", "ERROR")
            return
        end

        -- Stash any currently held tool so it never falls or disappears during morph
        local heldTools = {}
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(heldTools, item)
                item.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
            end
        end

        local targetModel = nil
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(userRes.UserId)
            if desc then
                targetModel = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
            end
        end)
        if not targetModel then
            pcall(function()
                targetModel = Players:CreateHumanoidModelFromUserId(userRes.UserId)
            end)
        end
        if not targetModel and userRes.Player and userRes.Player.Character then
            pcall(function()
                targetModel = userRes.Player.Character:Clone()
            end)
        end

        if not targetModel then
            AddLog(string.format("Failed to load catalog avatar model for '%s'", userRes.Name), "ERROR")
            return
        end

        pcall(function()
            local targetHrp = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
            if not targetHrp then targetHrp = targetModel:FindFirstChild("Torso") or targetModel:FindFirstChild("UpperTorso") end

            -- 1. CLEAN PREVIOUS MORPH ARTIFACTS
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") or item.Name:find("_MorphProxy") then
                    item:Destroy()
                end
            end

            -- 2. REPLACE ALL BODY PARTS & LIMBS WITH TARGET 3D CATALOG MESHES (Exact Body Shape / Bundle)
            local r15Parts = {
                "Head",
                "UpperTorso", "LowerTorso",
                "LeftUpperArm", "LeftLowerArm", "LeftHand",
                "RightUpperArm", "RightLowerArm", "RightHand",
                "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
                "RightUpperLeg", "RightLowerLeg", "RightFoot"
            }

            local oldParts = {}
            for _, partName in ipairs(r15Parts) do
                local oldP = char:FindFirstChild(partName)
                local newP = targetModel:FindFirstChild(partName)
                if oldP and newP then
                    if partName == "RightHand" then
                        -- Keep original RightHand instance alive so server tool welds (Bat, Katana, Eggs) never break
                        pcall(function() oldP.MeshId = newP.MeshId end)
                        pcall(function() oldP.TextureID = newP.TextureID end)
                        pcall(function() oldP.Size = newP.Size end)
                        for _, att in ipairs(newP:GetChildren()) do

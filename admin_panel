local function FindAndSpawnEgg(eggName, amount)
    amount = tonumber(amount) or 1
    if amount < 1 then amount = 1 end
    if amount > 100 then amount = 100 end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        AddLog("Character root part not found!", "ERROR")
        return
    end

    local hrp = character.HumanoidRootPart
    eggName = eggName:lower()

    local foundModel = nil
    local eggStorage = ReplicatedStorage:FindFirstChild("Assets") 
        and ReplicatedStorage.Assets:FindFirstChild("Models") 
        and ReplicatedStorage.Assets.Models:FindFirstChild("Eggs")

    if eggStorage then
        for _, child in ipairs(eggStorage:GetChildren()) do
            if child.Name:lower():find(eggName, 1, true) then
                foundModel = child
                break
            end
        end
    end

    if not foundModel then
        AddLog("egg not found", "ERROR")
        return
    end

    local formattedEggTitle = foundModel.Name
    AddLog(string.format("Spawning x%d '%s' (non-collidable)...", amount, formattedEggTitle), "INFO")

    local spacingX = 10.0
    local spacingZ = 10.0
    local maxPerRow = 10
    local spawnedCount = 0

    for i = 1, amount do
        local eggClone = foundModel:Clone()

        -- Make egg x2 bigger
        pcall(function()
            if eggClone:IsA("Model") then
                eggClone:ScaleTo(2)
            elseif eggClone:IsA("BasePart") then
                eggClone.Size = eggClone.Size * 2
            end
        end)

        for _, p in ipairs(eggClone:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Anchored = true
            end
        end

        -- Grid placement math: max 10 per row
        local rowIndex = math.floor((i - 1) / maxPerRow)
        local colIndex = (i - 1) % maxPerRow
        local itemsInThisRow = math.min(maxPerRow, amount - rowIndex * maxPerRow)

        local startX = -((itemsInThisRow - 1) * spacingX) / 2
        local xOffset = startX + colIndex * spacingX
        local zOffset = -10 - (rowIndex * spacingZ)

        local eggCFrame = hrp.CFrame * CFrame.new(xOffset, 1.0, zOffset)

        if eggClone:IsA("Model") then
            if not eggClone.PrimaryPart then
                for _, p in ipairs(eggClone:GetDescendants()) do
                    if p:IsA("BasePart") then eggClone.PrimaryPart = p break end
                end
            end
            if eggClone.PrimaryPart then
                eggClone:PivotTo(eggCFrame)
            end
        elseif eggClone:IsA("BasePart") then
            eggClone.CFrame = eggCFrame
        end

        eggClone.Parent = CreatedEggsFolder
        spawnedCount = spawnedCount + 1
    end

    local textSegments = {
        { Text = ActiveProfile.Name .. " ", Color = Color3.fromRGB(0, 180, 255) },
        { Text = string.format("spawned %d ", spawnedCount), Color = Color3.fromRGB(255, 255, 255) },
        { Text = formattedEggTitle .. "!", Color = Color3.fromRGB(255, 225, 0) }
    }

    ShowGameTopBanner(ActiveProfile.AvatarHeadshot, ActiveProfile.IsVerified, textSegments)
    AddLog(string.format("Spawned x%d '%s' (Grid: max 10/row)!", spawnedCount, formattedEggTitle), "SUCCESS")
end

